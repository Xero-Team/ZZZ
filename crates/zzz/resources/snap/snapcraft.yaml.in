name: zzz
title: ZZZ
base: core24
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  ZZZ is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer and local-first defaults.
grade: stable
confinement: classic
compression: lzo
website: https://codeberg.org/ZZZEditor/ZZZ
source-code: https://codeberg.org/ZZZEditor/ZZZ
issues: https://codeberg.org/ZZZEditor/ZZZ/issues
contact: https://codeberg.org/ZZZEditor/ZZZ/issues

parts:
  zzz:
    plugin: dump
    source: "https://github.com/zed-industries/zed/releases/download/v$RELEASE_VERSION/zzz-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it ZZZ exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it ZZZ exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  zzz:
    command: usr/bin/zzz
    common-id: dev.zzz.ZZZ
    environment:
      ZZZ_BUNDLE_TYPE: snap
