        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "sd_element"
          }
        }
      ]
    },
    "sd_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "id",
          "content": {
            "type": "SYMBOL",
            "name": "sd_id"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": " "
              },
              {
                "type": "SYMBOL",
                "name": "sd_param"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "sd_id": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\x00-\\x20\\x7f=\"\\]]+"
      }
    },
    "sd_param": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "param_name"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "param_value"
          }
        }
      ]
    },
    "param_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\x00-\\x20\\x7f=\"\\]]+"
      }
    },
    "param_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "param_value_fragment"
              },
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              }
            ]
          }
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "STRING",
            "value": "\""
          }
        }
      ]
    },
    "param_value_fragment": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\"\\\\\\]\\r\\n]+"
      }
    },
    "escape_sequence": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\\"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "STRING",
                "value": "\\"
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          }
        ]
      }
    },
    "message": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "utf8_message"
        },
        {
          "type": "SYMBOL",
          "name": "message_text"
        }
      ]
    },
    "utf8_message": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bom"
        },
        {
          "type": "FIELD",
          "name": "text",
          "content": {
            "type": "SYMBOL",
            "name": "message_text"
          }
        }
      ]
