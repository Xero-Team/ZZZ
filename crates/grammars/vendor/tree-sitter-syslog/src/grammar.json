        },
        {
          "type": "SYMBOL",
          "name": "prival"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "prival": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "0"
          },
          {
            "type": "PATTERN",
            "value": "[1-9]\\d{0,2}"
          }
        ]
      }
    },
    "version": {
      "type": "TOKEN",
      "content": {
