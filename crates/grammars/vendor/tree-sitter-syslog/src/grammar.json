            "name": "hostname"
          }
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "app_name",
          "content": {
            "type": "SYMBOL",
            "name": "app_name"
          }
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "FIELD",
          "name": "procid",
          "content": {
