{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "scheme",
      "camelcase": "Scheme",
      "scope": "source.scheme",
      "path": ".",
      "file-types": ["scm", "ss"]
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Scheme grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/6cdh/tree-sitter-scheme"
    }
  },
  "bindings": {
    "c": true,
    "rust": true
  }
}
