# Normalize text files to LF across platforms.
* text=auto eol=lf

# Prevent GitHub from displaying comments within JSON files as errors.
*.json linguist-language=JSON-with-Comments

# Ensure the WSL script always has LF line endings, even on Windows
crates/zzz/resources/windows/zzz.sh text eol=lf

# Patch payload whitespace is source data and must survive vendor reconstruction unchanged.
vendor/patches/**/*.patch -whitespace
