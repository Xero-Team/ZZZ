#!/usr/bin/env bash

set -euo pipefail

CARGO_ABOUT_VERSION="0.9.3"
IFS='|' read -r ffmpeg_series _ _ <<< "$(cargo xtask ffmpeg info)"
OUTPUT_FILE="${1:-$(pwd)/assets/licenses.csv}"
TEMPLATE_FILE="script/licenses/template.csv.hbs"

if ! cargo about --version | grep -q "cargo-about $CARGO_ABOUT_VERSION"; then
  echo "Installing cargo-about@$CARGO_ABOUT_VERSION..."
  cargo install "cargo-about@$CARGO_ABOUT_VERSION"
else
  echo "cargo-about@$CARGO_ABOUT_VERSION is already installed."
fi

echo "Generating cargo licenses"
set -x
cargo about generate \
    --fail \
    -c script/licenses/zzz-licenses.toml \
    $TEMPLATE_FILE \
    | awk 'NR==1{print;next} NF{print | "sort"}' \
    > "$OUTPUT_FILE"
set +x

echo "FFmpeg,${ffmpeg_series},LGPL-3.0-or-later,https://github.com/FFmpeg/FFmpeg/tree/release/${ffmpeg_series}" \
  >> "$OUTPUT_FILE"

echo "generate-licenses-csv completed. See $OUTPUT_FILE"
