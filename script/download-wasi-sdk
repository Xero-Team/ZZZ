#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/lib/github-release.sh"

WASI_SDK_DIR="./target/wasi-sdk"

# Determine OS and architecture
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Map architecture names to WASI SDK format
case $ARCH in
    x86_64)
        ARCH="x86_64"
        ;;
    arm64|aarch64)
        ARCH="arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

# Map OS names to WASI SDK format
case $OS in
    darwin)
        OS="macos"
        ;;
    linux)
        OS="linux"
        ;;
    mingw*|msys*|cygwin*)
        OS="windows"
        ;;
    *)
        echo "Unsupported OS: $OS"
        exit 1
        ;;
esac

if ! resolved="$(github_latest_asset WebAssembly/wasi-sdk "wasi-sdk-*-${ARCH}-${OS}.tar.gz")"; then
    echo "Unable to resolve the newest WASI SDK release for ${ARCH}-${OS}." >&2
    exit 1
fi
IFS='|' read -r tag archive expected_sha256 wasi_sdk_url <<< "$resolved"

installed_sha256=""
if [ -f "${WASI_SDK_DIR}/.zzz-wasi-sdk.sha256" ]; then
    installed_sha256=$(head -n 1 "${WASI_SDK_DIR}/.zzz-wasi-sdk.sha256" | tr -d '\r')
fi

if [ -d "${WASI_SDK_DIR}" ] && [ "${installed_sha256}" = "${expected_sha256}" ]; then
    echo "WASI SDK ${tag} is already installed at ${WASI_SDK_DIR}"
    exit 0
fi

unpacked_name="${archive%.tar.gz}"
echo "Downloading WASI SDK ${tag} from ${wasi_sdk_url}"

# Download, verify, and extract. Never stream an unverified archive directly
# into the target directory.
mkdir -p ./target
archive_path="./target/${archive}"
download_verified "$wasi_sdk_url" "$archive_path" "$expected_sha256" "$archive"

staging_dir="./target/${unpacked_name}.staging"
rm -rf "$staging_dir"
mkdir -p "$staging_dir"
tar --no-same-owner -xzf "$archive_path" -C "$staging_dir"

# Replace the previous SDK with the verified extraction.
rm -rf "${WASI_SDK_DIR}"
mv "${staging_dir}/${unpacked_name}" "${WASI_SDK_DIR}"
printf '%s\n' "$expected_sha256" > "${WASI_SDK_DIR}/.zzz-wasi-sdk.sha256"
rm -rf "$staging_dir"
rm -f "$archive_path"

echo "WASI SDK ${tag} installed at ${WASI_SDK_DIR}"
