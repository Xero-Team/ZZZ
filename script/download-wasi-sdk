#!/bin/bash
set -euo pipefail

WASI_SDK_VERSION="34"
WASI_SDK_DIR="./target/wasi-sdk"

sha256_for_platform() {
    case "$1" in
        x86_64-linux) printf '%s\n' 'b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4' ;;
        arm64-linux) printf '%s\n' 'f7e243dff54d60bcc576e94d6166b69f410f2500ae4a9ceef34315be10e77971' ;;
        x86_64-macos) printf '%s\n' '87d27fa8adc68dee59bfbf2e22a6d34ef717c34d6bf1d8af2a56fc929d9ce0eb' ;;
        arm64-macos) printf '%s\n' '9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9' ;;
        x86_64-windows) printf '%s\n' 'cccb5c323a9b34f0349a9b09e8804a0a7632c68c3310f4b5f437ed57d7e71d8f' ;;
        arm64-windows) printf '%s\n' '45e1c71f3e965621e7b98ebe1d37b0e4b1f77f3e8072113ffb4534e67b1a4b7c' ;;
        *) return 1 ;;
    esac
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d ' ' -f 1
    else
        shasum -a 256 "$1" | cut -d ' ' -f 1
    fi
}

installed_version=""
installed_sha256=""
if [ -f "${WASI_SDK_DIR}/VERSION" ]; then
    installed_version=$(head -n 1 "${WASI_SDK_DIR}/VERSION" | tr -d '\r')
fi
if [ -f "${WASI_SDK_DIR}/.zzz-wasi-sdk.sha256" ]; then
    installed_sha256=$(head -n 1 "${WASI_SDK_DIR}/.zzz-wasi-sdk.sha256" | tr -d '\r')
fi

if [ -d "${WASI_SDK_DIR}" ]; then
    echo "WASI SDK at ${WASI_SDK_DIR} is version '${installed_version}', replacing with v${WASI_SDK_VERSION}..."
else
    echo "WASI SDK not found, downloading v${WASI_SDK_VERSION}..."
fi

# Determine OS and architecture
OS=$(uname -s | tr '[:upper:]' '[:lower:]')
ARCH=$(uname -m)

# Map architecture names to WASI SDK format
case $ARCH in
    x86_64)
        ARCH="x86_64"
        ;;
    arm64|aarch64)
        ARCH="arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

# Map OS names to WASI SDK format
case $OS in
    darwin)
        OS="macos"
        ;;
    linux)
        OS="linux"
        ;;
    mingw*|msys*|cygwin*)
        OS="windows"
        ;;
    *)
        echo "Unsupported OS: $OS"
        exit 1
        ;;
esac

platform="${ARCH}-${OS}"
expected_sha256="$(sha256_for_platform "$platform")" || {
    echo "Unsupported WASI SDK platform: $platform" >&2
    exit 1
}

if [ "${installed_version}" = "${WASI_SDK_VERSION}.0" ] && [ "$installed_sha256" = "$expected_sha256" ]; then
    echo "WASI SDK v${WASI_SDK_VERSION} already exists at ${WASI_SDK_DIR}"
    exit 0
fi

# Construct download URL
WASI_SDK_ARCHIVE="wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-${OS}.tar.gz"
WASI_SDK_URL="https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/${WASI_SDK_ARCHIVE}"

echo "Downloading from: $WASI_SDK_URL"

# Create target directory if it doesn't exist
mkdir -p ./target

# Download, verify, and extract. Never stream an unverified archive directly
# into the target directory.
archive_path="./target/${WASI_SDK_ARCHIVE}"
partial_path="${archive_path}.part"
rm -f "$partial_path"
curl --fail --location --retry 3 --retry-all-errors -o "$partial_path" "$WASI_SDK_URL"
actual_sha256="$(sha256_file "$partial_path")"
if [ "$actual_sha256" != "$expected_sha256" ]; then
    echo "WASI SDK checksum mismatch: expected $expected_sha256, got $actual_sha256" >&2
    rm -f "$partial_path"
    exit 1
fi
mv "$partial_path" "$archive_path"

staging_dir="./target/wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-${OS}.staging"
rm -rf "$staging_dir"
mkdir -p "$staging_dir"
tar --no-same-owner -xzf "$archive_path" -C "$staging_dir"

# Rename the extracted directory to wasi-sdk
rm -rf "${WASI_SDK_DIR}"
mv "$staging_dir/wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-${OS}" "${WASI_SDK_DIR}"
printf '%s\n' "$expected_sha256" > "${WASI_SDK_DIR}/.zzz-wasi-sdk.sha256"
rm -f "$archive_path"

echo "WASI SDK v${WASI_SDK_VERSION} installed successfully"
