#!/usr/bin/env bash

# This script is intended to be run after `cargo xtask bundle --formats snap`.
#
# It expects a version to be passed as the first argument. The built `.snap`
# for that version is looked up in target/release, where the bundler puts it.
#
# This will uninstall the current `zzz` snap, replacing it with a snap
# that directly uses the `snap/unpacked` directory.

set -euxo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <release_version>"
  exit 1
fi

# Rerun as root
[ "$UID" -eq 0 ] || exec sudo bash -e "$0" "$@"

snap_file="$(ls "target/release/zzz_$1"_*.snap 2>/dev/null | head -n 1 || true)"
if [[ -z "${snap_file}" ]]; then
  echo "No snap for $1 in target/release; run cargo xtask bundle --formats snap first." >&2
  exit 1
fi

snap remove zzz || true
mkdir -p snap
rm -rf snap/unpacked
unsquashfs -dest snap/unpacked "${snap_file}"
snap try --classic snap/unpacked
