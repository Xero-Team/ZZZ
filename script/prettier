#!/bin/bash
set -euxo pipefail

PRETTIER_VERSION=3.9.10

if [[ "${1:-}" == "--write" ]]; then
    MODE="--write"
else
    MODE="--check"
fi

# Prefer pnpm's content-addressed store; fall back to npx so a machine (and the
# CI runner) needs only Node. Both paths pin the same Prettier version.
if command -v pnpm >/dev/null 2>&1; then
    RUNNER=(pnpm dlx)
else
    RUNNER=(npx --yes)
fi

run_prettier() {
    "${RUNNER[@]}" "prettier@${PRETTIER_VERSION}" "$@" "$MODE"
}

run_prettier assets/settings/default.json --parser=jsonc || {
    echo "To fix, run from the root of the ZZZ repo:"
    echo "  script/prettier --write"
    false
}

cd docs
run_prettier . || {
    echo "To fix, run from the root of the ZZZ repo:"
    echo "  script/prettier --write"
    false
}
