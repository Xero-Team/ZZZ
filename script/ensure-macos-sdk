#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$0")/lib/github-release.sh"

# Prints the path to a usable macOS SDK, downloading the newest one on
# non-Darwin hosts. Pass a release tag (for example `14.5`) to select a
# specific SDK instead.

sdk_ok() {
  [[ -n "${1:-}" && -f "$1/System/Library/Frameworks/CoreServices.framework/Headers/CoreServices.h" ]]
}

if sdk_ok "${SDKROOT:-}"; then
  printf '%s\n' "$SDKROOT"
  exit 0
fi

if [[ "$(uname -s)" == Darwin ]]; then
  path="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
  if sdk_ok "$path"; then
    printf '%s\n' "$path"
    exit 0
  fi
fi

version="${1:-}"
if [[ -n "$version" ]]; then
  if ! resolved="$(github_asset joseluisq/macosx-sdks "MacOSX${version}.sdk.tar.xz" "$version")"; then
    echo "Unsupported macOS SDK version: $version" >&2
    exit 1
  fi
else
  if ! resolved="$(github_latest_asset joseluisq/macosx-sdks "MacOSX*.sdk.tar.xz")"; then
    echo "Error: unable to resolve the newest macOS SDK release." >&2
    exit 1
  fi
fi
IFS='|' read -r sdk_version sdk_archive sdk_sha256 sdk_url <<< "$resolved"
sdk_name="${sdk_archive%.tar.xz}"

# Older releases predate the checksum GitHub reports for each asset; those
# releases ship a `sha256sum.txt` next to the SDK tarball instead.
if [[ -z "$sdk_sha256" ]]; then
  sdk_sha256="$(
    curl --silent --show-error --fail --location --retry 3 --retry-all-errors \
      "https://github.com/joseluisq/macosx-sdks/releases/download/${sdk_version}/sha256sum.txt" |
      awk -v name="$sdk_archive" '$2 == name { print $1; exit }'
  )"
fi

tmp="${TMPDIR:-/tmp}"
sdk_root="$tmp/zzz-macos-sdk"
sdk_path="$sdk_root/$sdk_name"
if sdk_ok "$sdk_path"; then
  printf '%s\n' "$sdk_path"
  exit 0
fi

mkdir -p "$sdk_root"
tarball="$tmp/zzz-${sdk_archive}.$$"
download_verified "$sdk_url" "$tarball" "$sdk_sha256" "$sdk_archive"
tar -xJf "$tarball" -C "$sdk_root"
rm -f "$tarball"
if ! sdk_ok "$sdk_path"; then
  echo "Error: ${sdk_archive} did not extract to ${sdk_path}." >&2
  exit 1
fi
printf '%s\n' "$sdk_path"
