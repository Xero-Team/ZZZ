#!/usr/bin/env bash

set -euo pipefail

# Prints the path to a usable macOS SDK, downloading one on non-Darwin hosts.
# An optional version argument selects the SDK (default: 14.5). 14.5 is used
# everywhere because the full GUI app references CoreAudio process-tap APIs
# that older SDKs do not declare.

sdk_ok() {
  [[ -n "${1:-}" && -f "$1/System/Library/Frameworks/CoreServices.framework/Headers/CoreServices.h" ]]
}

if sdk_ok "${SDKROOT:-}"; then
  printf '%s\n' "$SDKROOT"
  exit 0
fi

if [[ "$(uname -s)" == Darwin ]]; then
  path="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
  if sdk_ok "$path"; then
    printf '%s\n' "$path"
    exit 0
  fi
fi

version="${1:-14.5}"
case "$version" in
  14.5)
    sdk_name="MacOSX14.5.sdk"
    sdk_url="https://github.com/joseluisq/macosx-sdks/releases/download/14.5/MacOSX14.5.sdk.tar.xz"
    sdk_sha256="6e146275d19f027faa2e8354da5e0267513abf013b8f16ad65a231653a2b1c5d"
    ;;
  *)
    echo "Unsupported macOS SDK version: $version (supported: 14.5)" >&2
    exit 1
    ;;
esac

tmp="${TMPDIR:-/tmp}"
sdk_root="$tmp/zzz-macos-sdk"
sdk_path="$sdk_root/$sdk_name"
if sdk_ok "$sdk_path"; then
  printf '%s\n' "$sdk_path"
  exit 0
fi

mkdir -p "$sdk_root"
tarball="$tmp/zzz-$sdk_name.tar.xz.$$"
curl -fL --retry 3 -o "$tarball" "$sdk_url"
if command -v shasum >/dev/null 2>&1; then
  actual_sha256="$(shasum -a 256 "$tarball" | cut -d ' ' -f 1)"
else
  actual_sha256="$(sha256sum "$tarball" | cut -d ' ' -f 1)"
fi
if [[ "$actual_sha256" != "$sdk_sha256" ]]; then
  echo "$sdk_name checksum mismatch: expected $sdk_sha256, got $actual_sha256" >&2
  rm -f "$tarball"
  exit 1
fi
tar -xJf "$tarball" -C "$sdk_root"
rm -f "$tarball"
sdk_ok "$sdk_path"
printf '%s\n' "$sdk_path"
