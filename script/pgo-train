#!/usr/bin/env bash
#
# Runs a PGO-instrumented ZZZ bundle through a scripted editing session.
#
# Usage: script/pgo-train APP_DIR
#
# APP_DIR is the extracted `.app` directory produced by the instrumented build,
# for example `target/pgo/bundle/zzz.app`. `cargo xtask pgo train` builds the
# bundle, extracts it, and calls this script.
#
# The session opens a generated 100,000-line Rust file in a throwaway project,
# types code into it, runs a buffer search, scrolls, resizes the window a few
# times, and quits through the editor's own quit action. Quitting has to be
# clean: LLVM writes the profile from an exit handler, so a killed process
# leaves no data behind.
#
# Requires an X11 display (Xvfb is fine) and `xdotool`.
#
# Environment:
#   ZZZ_PGO_TRAIN_DIR=/abs/dir   Fixture workspace (default: a temp directory)
#   ZZZ_PGO_TRAIN_KEEP=1         Keep the fixture workspace after the run
#   ZZZ_PGO_TRAIN_REGENERATE=1   Regenerate the workload file before the run
#   ZZZ_PGO_TRAIN_SETTLE=<s>     Seconds to wait after the window appears before
#                                driving it (default: 8)
#   ZZZ_PGO_TRAIN_TIMEOUT=<s>    Seconds to wait for the window (default: 120)

set -euo pipefail
cd "$(dirname "$0")/.."

help_info() {
    echo "
Usage: ${0##*/} APP_DIR

Drives the PGO-instrumented editor in APP_DIR through a representative editing
session so the profile covers real work: typing, search, scrolling, and resizing.

Environment:
  ZZZ_PGO_TRAIN_DIR=/abs/dir   Fixture workspace (default: a temp directory)
  ZZZ_PGO_TRAIN_KEEP=1         Keep the fixture workspace after the run
  ZZZ_PGO_TRAIN_REGENERATE=1   Regenerate the workload file before the run
  ZZZ_PGO_TRAIN_SETTLE=<s>     Idle seconds before driving the window (default: 8)
  ZZZ_PGO_TRAIN_TIMEOUT=<s>    Seconds to wait for the window (default: 120)
  "
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    help_info
    exit 0
fi

app_dir="${1:-}"
if [[ -z "${app_dir}" ]]; then
    help_info >&2
    exit 1
fi
editor="${app_dir%/}/libexec/zzz-editor"
if [[ ! -x "${editor}" ]]; then
    echo "Error: ${editor} is missing or not executable." >&2
    echo "Pass the extracted .app directory from the instrumented bundle." >&2
    exit 1
fi

if [[ -z "${DISPLAY:-}" ]]; then
    echo "Error: no X11 display. Run this under Xvfb, for example:" >&2
    echo "  xvfb-run --auto-servernum ${0}" >&2
    exit 1
fi
if ! command -v xdotool >/dev/null 2>&1; then
    echo "Error: xdotool is required to drive the training session." >&2
    echo "Install it with: sudo apt-get install xdotool" >&2
    exit 1
fi

settle_seconds="${ZZZ_PGO_TRAIN_SETTLE:-8}"
window_timeout="${ZZZ_PGO_TRAIN_TIMEOUT:-120}"
quit_timeout=120

# A simple `kill -0` also succeeds for a zombie, and the editor becomes one as
# soon as it exits while this shell has not reaped it yet.
process_is_alive() {
    local pid="${1:-}"
    [[ -n "${pid}" ]] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    local state
    state="$(sed -n 's/^State:[[:space:]]*\([A-Z]\).*/\1/p' "/proc/${pid}/status" 2>/dev/null || true)"
    [[ -n "${state}" && "${state}" != "Z" ]]
}

workspace_dir="${ZZZ_PGO_TRAIN_DIR:-}"
created_workspace=false
if [[ -z "${workspace_dir}" ]]; then
    workspace_dir="$(mktemp -d "${TMPDIR:-/tmp}/zzz-pgo-train.XXXXXX")"
    created_workspace=true
fi
# Open the folder rather than the file so the workload covers a scanned
# worktree and the file finder.
mkdir -p "${workspace_dir}"
workspace_dir="$(cd "${workspace_dir}" && pwd)"
project_dir="${workspace_dir}/project"
mkdir -p "${project_dir}"
source_file="${project_dir}/pgo_workload.rs"
log_file="${workspace_dir}/zzz.log"

editor_pid=""
cleanup() {
    if process_is_alive "${editor_pid}"; then
        kill -KILL "${editor_pid}" 2>/dev/null || true
    fi
    if [[ "${created_workspace}" == "true" && "${ZZZ_PGO_TRAIN_KEEP:-}" != "1" ]]; then
        rm -rf "${workspace_dir}"
    fi
}
trap cleanup EXIT

if [[ ! -f "${source_file}" || "${ZZZ_PGO_TRAIN_REGENERATE:-}" == "1" ]]; then
    echo "PGO train: generating ${source_file}"
    awk -v functions=12500 '
        BEGIN {
            print("// Generated by script/pgo-train. Not part of the repository.")
            print("use std::collections::HashMap;")
            print("")
            print("pub struct State {")
            print("    cache: HashMap<String, u64>,")
            print("    depth: usize,")
            print("}")
            print("")
            print("impl Default for State {")
            print("    fn default() -> Self {")
            print("        Self { cache: HashMap::new(), depth: 0 }")
            print("    }")
            print("}")
            print("")
            for (i = 0; i < functions; i++) {
                value = (i * 2654435761) % 4294967296
                high = int(value / 65536)
                low = value % 65536
                hex = sprintf("%04x%04x", high, low)
                printf("pub fn line_%06d(input: &mut State, index: usize) -> u64 {\n", i)
                printf("    let mixed = (index as u64).wrapping_mul(0x%s);\n", hex)
                printf("    let entry = input.cache.entry(\"line_%06d\").or_insert(mixed);\n", i)
                printf("    *entry ^= mixed.rotate_left(7) ^ (input.depth as u64);\n")
                printf("    input.depth = input.depth.wrapping_add(1);\n")
                printf("    *entry\n")
                printf("}\n")
                printf("\n")
            }
        }
    ' > "${source_file}"
fi

# Keep the run away from the real editor state, and let the editor quit without
# a confirmation dialog. The fixture worktree stays untrusted on purpose: in
# restricted mode ZZZ starts no language server and downloads nothing, which
# keeps the session repeatable.
user_data_dir="${workspace_dir}/user-data"
mkdir -p "${user_data_dir}/config"
cat > "${user_data_dir}/config/settings.json" <<'SETTINGS'
{
  "confirm_quit": false,
  "languages": {
    "Rust": {
      "format_on_save": "off"
    }
  }
}
SETTINGS

echo "PGO train: launching ${editor}"
# CI renders through Mesa's software rasterizer, and ZZZ blocks that with an
# "Unsupported GPU" dialog that swallows every following keystroke. The dialog
# is exactly right for users and exactly wrong for a training run.
ZZZ_ALLOW_EMULATED_GPU=1 "${editor}" --user-data-dir "${user_data_dir}" "${project_dir}" >"${log_file}" 2>&1 &
editor_pid=$!

window_id=""
deadline=$((SECONDS + window_timeout))
while (( SECONDS < deadline )); do
    if ! process_is_alive "${editor_pid}"; then
        echo "Error: the editor exited before opening a window." >&2
        tail -n 40 "${log_file}" >&2 || true
        exit 1
    fi
    window_id="$(xdotool search --onlyvisible --pid "${editor_pid}" 2>/dev/null | head -n 1 || true)"
    if [[ -n "${window_id}" ]]; then
        break
    fi
    sleep 1
done

if [[ -z "${window_id}" ]]; then
    echo "Error: no window appeared within ${window_timeout}s." >&2
    tail -n 40 "${log_file}" >&2 || true
    exit 1
fi
echo "PGO train: driving window ${window_id}"

# There is no window manager under Xvfb, so activation is best effort and focus
# is set directly. Key events go to the focused window.
xdotool windowactivate --sync "${window_id}" 2>/dev/null || true
xdotool windowfocus --sync "${window_id}"
xdotool windowsize --sync "${window_id}" 1440 900
# Move the pointer over the editor and click once: the pane has to own the focus
# before keystrokes reach it.
xdotool mousemove --window "${window_id}" 700 400
xdotool click 1
sleep "${settle_seconds}"

# The project opens empty, so the workload file has to come in through the file
# finder. Typing into a just-opened project would land in whatever the start
# screen put under the cursor.
echo "PGO train: opening $(basename "${source_file}")"
source_name="$(basename "${source_file}")"
open_workload() {
    local attempt waited
    for attempt in 1 2 3; do
        xdotool key --clearmodifiers ctrl+p
        sleep 2
        xdotool type --delay 20 --clearmodifiers -- "${source_name}"
        sleep 2
        xdotool key --clearmodifiers Return
        # The window title gains " — <file>" once the buffer is open, which is
        # the only reliable signal that the keystrokes that follow have a target.
        waited=0
        while (( waited < 15 )); do
            if xdotool getwindowname "${window_id}" 2>/dev/null | grep -qF -- "${source_name}"; then
                return 0
            fi
            sleep 1
            waited=$((waited + 1))
        done
        echo "PGO train: no buffer for ${source_name} yet (attempt ${attempt})" >&2
    done
    return 1
}
if ! open_workload; then
    echo "Error: the file finder never opened ${source_file}." >&2
    echo "Log tail:" >&2
    tail -n 40 "${log_file}" >&2 || true
    exit 1
fi
xdotool mousemove --window "${window_id}" 700 400
xdotool click 1
sleep 1

echo "PGO train: typing"
typing_marker="pgo_training_marker"
end_marker="pgo_training_end"
marker_line="    // ${typing_marker}: the trainer greps for this line after saving."
typed_lines=(
    'fn update(&mut self, cx: &mut Context<Self>) -> Result<()> {'
    '    let Some(entry) = self.cache.get(&self.key) else {'
    '        return Err(anyhow!("missing entry for {}", self.key));'
    '    };'
    '    self.buffer.edit(|buffer| buffer.insert(0, "pgo", cx))?;'
    '    cx.notify();'
    '    Ok(())'
    '}'
    'pub struct Cache<K, V> where K: Eq + Hash { entries: HashMap<K, V> }'
    '#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]'
    'impl<K: Eq + Hash, V: Default> Default for Cache<K, V> {'
    '    fn default() -> Self { Self { entries: HashMap::new() } }'
    '}'
    'const TABLE: [u32; 8] = [0x5a5a_4750, 0x5549_2026, 1, 2, 3, 5, 8, 13];'
    "let values: Vec<String> = pairs.iter().filter(|(key, _)| key.starts_with(\"line_\")).map(|(_, value)| value.to_string()).collect(); // ${end_marker}"
)

# A buffer that is still loading drops keystrokes, and so does a window that
# never took the focus. Typing one line and looking for it on disk is the only
# reliable check; a session that types into the start screen still writes a
# profile, just a useless one.
type_line() {
    xdotool type --delay "${1}" --clearmodifiers -- "${2}"
    xdotool key --clearmodifiers Return
}

save_and_wait() {
    # Leave no dirty buffer behind, so quitting never waits on a save prompt.
    xdotool key --clearmodifiers ctrl+s
    sleep 2
}

marker_saved=false
for attempt in 1 2 3; do
    xdotool mousemove --window "${window_id}" 700 400
    xdotool click 1
    sleep 2
    type_line 20 "${marker_line}"
    save_and_wait
    if grep -qF -- "${typing_marker}" "${source_file}"; then
        marker_saved=true
        break
    fi
    echo "PGO train: the first line never reached ${source_name} (attempt ${attempt})" >&2
done
if [[ "${marker_saved}" != "true" ]]; then
    echo "Error: keystrokes never reached ${source_file}." >&2
    echo "The window never took focus, or the buffer never finished loading." >&2
    echo "Log tail:" >&2
    tail -n 40 "${log_file}" >&2 || true
    exit 1
fi

# The rest of the batch goes in from the focused pane. A renderer that is still
# busy can swallow the tail of it, so the last line carries a second marker and
# the batch is retried until that marker lands on disk.
batch_delay=25
batch_saved=false
for attempt in 1 2 3; do
    sleep 1
    xdotool mousemove --window "${window_id}" 700 400
    xdotool click 1
    sleep 1
    for line in "${typed_lines[@]}"; do
        type_line "${batch_delay}" "${line}"
    done
    save_and_wait
    if grep -qF -- "${end_marker}" "${source_file}"; then
        batch_saved=true
        break
    fi
    echo "PGO train: the typed batch was truncated (attempt ${attempt})" >&2
    batch_delay=$((batch_delay * 2))
done
if [[ "${batch_saved}" != "true" ]]; then
    echo "Error: only part of the typed batch reached ${source_file}." >&2
    echo "Log tail:" >&2
    tail -n 40 "${log_file}" >&2 || true
    exit 1
fi
# A session that types into an empty start screen still writes a profile, just a
# useless one, so check the buffer instead of trusting the keystrokes.
if ! grep -q "${typing_marker}" "${source_file}"; then
    echo "Error: the typed text never reached ${source_file}." >&2
    echo "The file finder did not open the workload, or the window never took" >&2
    echo "focus. Log tail:" >&2
    tail -n 40 "${log_file}" >&2 || true
    exit 1
fi

echo "PGO train: searching"
xdotool key --clearmodifiers ctrl+f
sleep 1
xdotool type --delay 10 --clearmodifiers -- "line_0004"
sleep 1
xdotool key --clearmodifiers Return
sleep 1
xdotool key --clearmodifiers Return
sleep 1
xdotool key --clearmodifiers Escape
sleep 1

echo "PGO train: scrolling"
xdotool mousemove --window "${window_id}" 700 500
xdotool click --repeat 60 --delay 20 5
sleep 1
xdotool click --repeat 30 --delay 20 4
sleep 1

echo "PGO train: resizing"
for geometry in "1600 1000" "1024 768" "1280 720" "900 600" "1440 900"; do
    read -r width height <<<"${geometry}"
    xdotool windowsize --sync "${window_id}" "${width}" "${height}"
    sleep 1
done

echo "PGO train: quitting"
xdotool key --clearmodifiers ctrl+q
deadline=$((SECONDS + quit_timeout))
while process_is_alive "${editor_pid}"; do
    if (( SECONDS >= deadline )); then
        echo "Error: the editor did not exit within ${quit_timeout}s of the quit" >&2
        echo "shortcut, so the profile was never flushed. Log tail:" >&2
        tail -n 40 "${log_file}" >&2 || true
        exit 1
    fi
    sleep 1
done
wait "${editor_pid}" 2>/dev/null || true
editor_pid=""

if [[ "${ZZZ_PGO_TRAIN_KEEP:-}" == "1" ]]; then
    echo "PGO train: kept the fixture workspace at ${workspace_dir}"
fi
echo "PGO train: session complete"
