#!/usr/bin/env bash

set -euxo pipefail

usage() {
  echo "
  Usage: ${0##*/} [options]
  Builds and installs zzz onto your system into ~/.local, making it available as ~/.local/bin/zzz.

  Options:
    -h, --help   Show this help and exit
    -i, --native Build the local app with the linux-native profile and target-cpu=native

  Environment:
    ZZZ_PGO_GENERATE_DIR=/abs/dir   Build an instrumented native binary for PGO training
    ZZZ_PGO_PROFILE=/abs/file       Use merged PGO data when building the native binary
    ZZZ_BOLT_PREPARE=1              Build a native binary suitable for later perf2bolt/llvm-bolt optimization
    ZZZ_BOLT_INSTRUMENT_FILE=/abs/file  Build an instrumented native binary for BOLT training
    ZZZ_BOLT_PERF=/abs/file         Optimize the native binary with BOLT using this perf.data
    ZZZ_BOLT_FDATA=/abs/file        Optimize the native binary with BOLT using this .fdata

  Before running this you should ensure you have all the build dependencies installed with \`./script/linux\`.
  "
}

host_build_profile=release
bundle_args=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help)
      usage
      exit 0
      ;;
    -i|--native)
      host_build_profile=linux-native
      bundle_args+=(--native)
      shift
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

export ZZZ_CHANNEL=$(<crates/zzz/RELEASE_CHANNEL)
export ZZZ_UPDATE_EXPLANATION="You need to fetch and rebuild zzz in $(pwd)"
script/bundle-linux "${bundle_args[@]}"

arch="$(uname -m)"
commit=$(git rev-parse HEAD | cut -c 1-7)
archive="zzz-linux-${arch}.tar.gz"
export ZZZ_BUNDLE_PATH="${CARGO_TARGET_DIR:-target}/${host_build_profile}/${archive}"
script/install.sh
