#!/usr/bin/env bash

set -euxo pipefail

skip_build=false
positional=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: $0 [--skip-build] <release_version>"
      echo
      echo "  --skip-build   Reuse an existing bundle instead of running script/bundle-linux"
      exit 0
      ;;
    --skip-build)
      skip_build=true
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo "Usage: $0 [--skip-build] <release_version>" >&2
      exit 1
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done

if [ "${#positional[@]}" -ne 1 ]; then
  echo "Usage: $0 [--skip-build] <release_version>"
  exit 1
fi
release_version="${positional[0]}"

if ! command -v snapcraft >/dev/null 2>&1; then
  echo "Error: Snap packaging requires snapcraft on PATH." >&2
  echo "Install with: sudo snap install snapcraft --classic" >&2
  exit 1
fi

workspace_root="$(pwd)"
if [[ -z "${ZZZ_SNAP_ARCHIVE:-}" ]]; then
  if [[ "$skip_build" == false ]]; then
    script/bundle-linux
  fi
  snap_arch="$(uname -m)"
  ZZZ_SNAP_ARCHIVE="${workspace_root}/target/release/zzz-linux-${snap_arch}.tar.gz"
fi
if [[ ! -f "$ZZZ_SNAP_ARCHIVE" ]]; then
  echo "Snap source archive not found: $ZZZ_SNAP_ARCHIVE" >&2
  echo "Build one with script/bundle-linux or set ZZZ_SNAP_ARCHIVE." >&2
  exit 1
fi

mkdir -p snap/gui

export DO_STARTUP_NOTIFY="true"
export APP_NAME="ZZZ"
export APP_CLI="zzz"
export APP_ICON="\${SNAP}/meta/gui/zzz.png"
export APP_ARGS="%U"
envsubst < "crates/zzz/resources/zzz.desktop.in" > "snap/gui/zzz.desktop"
cp "crates/zzz/resources/app-icon.png" "snap/gui/zzz.png"

RELEASE_VERSION="$release_version" SNAP_ARCHIVE="$ZZZ_SNAP_ARCHIVE" envsubst < crates/zzz/resources/snap/snapcraft.yaml.in > snap/snapcraft.yaml

# Clean seems to be needed to actually check that the snapcraft.yaml
# works.  For example, when a `stage-package` is removed, it will
# still remain on rebuild.
snapcraft clean

snapcraft
