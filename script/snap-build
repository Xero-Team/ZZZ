#!/usr/bin/env bash

set -euxo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <release_version>"
  exit 1
fi

workspace_root="$(pwd)"
if [[ -z "${ZZZ_SNAP_ARCHIVE:-}" ]]; then
  script/bundle-linux
  snap_arch="$(uname -m)"
  ZZZ_SNAP_ARCHIVE="${workspace_root}/target/release/zzz-linux-${snap_arch}.tar.gz"
fi
if [[ ! -f "$ZZZ_SNAP_ARCHIVE" ]]; then
  echo "Snap source archive not found: $ZZZ_SNAP_ARCHIVE" >&2
  echo "Build one with script/bundle-linux or set ZZZ_SNAP_ARCHIVE." >&2
  exit 1
fi

mkdir -p snap/gui

export DO_STARTUP_NOTIFY="true"
export APP_NAME="ZZZ"
export APP_CLI="zzz"
export APP_ICON="\${SNAP}/meta/gui/zzz.png"
export APP_ARGS="%U"
envsubst < "crates/zzz/resources/zzz.desktop.in" > "snap/gui/zzz.desktop"
cp "crates/zzz/resources/app-icon.png" "snap/gui/zzz.png"

RELEASE_VERSION="$1" SNAP_ARCHIVE="$ZZZ_SNAP_ARCHIVE" envsubst < crates/zzz/resources/snap/snapcraft.yaml.in > snap/snapcraft.yaml

# Clean seems to be needed to actually check that the snapcraft.yaml
# works.  For example, when a `stage-package` is removed, it will
# still remain on rebuild.
snapcraft clean

snapcraft
