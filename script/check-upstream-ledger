#!/usr/bin/env python3
"""Validate the two upstream decision ledgers.

`upstream-ledger.tsv` records the A and B decisions - what a batch absorbed, and
whether local history can prove it happened. `upstream-rejected.tsv` records the
C decisions a batch skipped. Both are generated from the decision tables in the
sync reports, so this checks that each reproduces byte for byte, that the rows
are well formed, and that the two accounts agree: a SHA is in one file or the
other, and a rejection row never names a commit that was actually absorbed.

Known absorbed-but-still-listed commits live in script/upstream-ledger-allowlist;
a stale allowlist entry is itself a failure.
"""

import difflib
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEVELOPMENT = ROOT / "docs" / "src" / "development"
REPORTS = DEVELOPMENT / "upstream"
LEDGER = DEVELOPMENT / "upstream-rejected.tsv"
ABSORBED = DEVELOPMENT / "upstream-ledger.tsv"
ALLOWLIST = ROOT / "script" / "upstream-ledger-allowlist"
BACKFILL = ROOT / "script" / "backfill-upstream-ledger"

SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")
ABSORBED_RE = re.compile(r"(?:Upstream: |cherry picked from commit )([0-9a-f]{7,40})")

# A disposition that names a crate source path or a Rust symbol is describing a
# local surface, so binning it as infrastructure hides the real reason.
INFRA_REASONS = ("upstream-infra", "release-metadata")
LOCAL_SURFACE_RE = re.compile(
    r"crates/[a-z_0-9]+/"
    r"|`[A-Za-z_][A-Za-z_0-9]*(?:::[A-Za-z_0-9]+)+`"
    r"|`[A-Z][A-Za-z0-9]+`"
)

# Keep in sync with REASONS in script/backfill-upstream-ledger.
REASONS = (
    "philosophy",
    "absent-api",
    "unisolatable",
    "upstream-infra",
    "release-metadata",
    "diverged",
    "untriaged",
)

# Keep in sync with VERIFY_STATUSES in script/backfill-upstream-ledger.
VERIFY_STATUSES = ("verified", "equivalent", "unverified", "unknown")

CLASSES = ("A", "B")

failures = 0


def fail(message):
    global failures
    failures = failures + 1
    print("FAIL: " + message, file=sys.stderr)


def data_rows(text):
    rows = []
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split("\t")
        if fields[0] == "sha":
            continue
        rows.append(fields)
    return rows


def regenerate():
    """Runs the backfill into a scratch directory and returns both files."""
    directory = Path(tempfile.mkdtemp(suffix="-upstream-ledger"))
    try:
        subprocess.run(
            [str(BACKFILL), str(directory)],
            check=True,
            stdout=subprocess.DEVNULL,
        )
        return {
            path.name: (directory / path.name).read_text(encoding="utf-8")
            for path in (LEDGER, ABSORBED)
        }
    finally:
        for path in (LEDGER, ABSORBED):
            (directory / path.name).unlink(missing_ok=True)
        directory.rmdir()


def check_stale(name, actual, expected):
    if actual == expected:
        return
    fail(name + " is stale; run ./script/backfill-upstream-ledger")
    diff = difflib.unified_diff(
        actual.splitlines(),
        expected.splitlines(),
        "committed",
        "expected",
        lineterm="",
    )
    for line in list(diff)[:40]:
        print(line, file=sys.stderr)


def check_rows(rows):
    seen = {}
    for fields in rows:
        if len(fields) != 5:
            fail("row does not have 5 fields: " + repr(fields))
            continue
        sha = fields[0]
        cls = fields[1]
        reason = fields[2]
        note = fields[3]
        if not SHA_RE.match(sha):
            fail("bad sha: " + sha)
        if cls != "C":
            fail("non-C row in the rejection ledger: " + sha)
        if reason not in REASONS:
            fail("unknown reason_code " + reason + " for " + sha)
        if not note.strip():
            fail("empty note for " + sha)
        prefix = sha[:8]
        if prefix in seen:
            fail("duplicate sha prefix " + prefix + ": " + sha + " and " + seen[prefix])
        seen[prefix] = sha
    return seen


def check_absorbed_rows(rows):
    seen = {}
    for fields in rows:
        if len(fields) != 4:
            fail("absorbed row does not have 4 fields: " + repr(fields))
            continue
        sha, cls, verify, report = fields
        if not SHA_RE.match(sha):
            fail("bad sha in the absorbed ledger: " + sha)
        if cls not in CLASSES:
            fail("non-A/B row in the absorbed ledger: " + sha)
        if verify not in VERIFY_STATUSES:
            fail("unknown verify_status " + verify + " for " + sha)
        if not (REPORTS / report).is_file():
            fail("absorbed row " + sha + " names a missing report: " + report)
        prefix = sha[:8]
        if prefix in seen:
            fail("duplicate sha prefix " + prefix + ": " + sha + " and " + seen[prefix])
        seen[prefix] = sha
    return seen


def check_disjoint(absorbed, rejected):
    for prefix in absorbed:
        if prefix in rejected:
            fail(
                "sha prefix "
                + prefix
                + " is both absorbed ("
                + absorbed[prefix]
                + ") and rejected ("
                + rejected[prefix]
                + ")"
            )


def check_unverified(rows):
    """A recorded absorption with no local evidence is the gap this ledger exists
    to surface, so it fails instead of sitting in the file as a detail."""
    for fields in rows:
        if len(fields) != 4:
            continue
        sha, _, verify, report = fields
        if verify != "unverified":
            continue
        fail(
            "absorbed row "
            + sha
            + " ("
            + report
            + ") has no local commit carrying its trailer; absorb it, or record in"
            " the report that the tree already matched upstream"
        )


def load_allowlist():
    allowed = []
    if not ALLOWLIST.is_file():
        return allowed
    for line in ALLOWLIST.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        allowed.append(line.split()[0][:8])
    return allowed


def absorbed_prefixes():
    log = subprocess.run(
        ["git", "-C", str(ROOT), "log", "--format=%B"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    prefixes = set()
    for match in ABSORBED_RE.finditer(log):
        prefixes.add(match.group(1)[:8])
    return prefixes


def check_absorbed(seen):
    allowed = load_allowlist()
    absorbed = absorbed_prefixes()
    for prefix in seen:
        if prefix in absorbed and prefix not in allowed:
            fail(
                "ledger sha "
                + seen[prefix]
                + " is also an absorbed commit; fix the report or allowlist it"
            )
    for prefix in allowed:
        if prefix not in seen:
            fail("stale allowlist entry " + prefix + ": not in the ledger")
        elif prefix not in absorbed:
            fail("stale allowlist entry " + prefix + ": not an absorbed commit")


def check_infra_notes(rows):
    for fields in rows:
        if len(fields) != 5:
            continue
        sha, reason, note = fields[0], fields[2], fields[3]
        if reason not in INFRA_REASONS:
            continue
        match = LOCAL_SURFACE_RE.search(note)
        if match:
            fail(
                "row "
                + sha
                + " is binned "
                + reason
                + " but its note names a local surface ("
                + match.group(0)
                + ")"
            )


def main():
    missing = [path for path in (LEDGER, ABSORBED) if not path.is_file()]
    if missing:
        for path in missing:
            print("FAIL: missing " + str(path), file=sys.stderr)
        return 1

    expected = regenerate()
    rejected_text = LEDGER.read_text(encoding="utf-8")
    absorbed_text = ABSORBED.read_text(encoding="utf-8")
    check_stale(LEDGER.name, rejected_text, expected[LEDGER.name])
    check_stale(ABSORBED.name, absorbed_text, expected[ABSORBED.name])

    rejected_rows = data_rows(rejected_text)
    absorbed_rows = data_rows(absorbed_text)
    rejected_seen = check_rows(rejected_rows)
    absorbed_seen = check_absorbed_rows(absorbed_rows)
    check_disjoint(absorbed_seen, rejected_seen)
    check_unverified(absorbed_rows)
    check_absorbed(rejected_seen)
    check_infra_notes(rejected_rows)

    if failures:
        print(
            "upstream ledger check failed with " + str(failures) + " violation(s)",
            file=sys.stderr,
        )
        return 1
    verified = sum(
        1 for fields in absorbed_rows if len(fields) == 4 and fields[2] == "verified"
    )
    print(
        "upstream ledger check passed ("
        + str(len(absorbed_rows))
        + " absorbed rows, "
        + str(verified)
        + " verified; "
        + str(len(rejected_rows))
        + " rejection rows)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
