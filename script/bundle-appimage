#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a Linux AppImage from the release bundle.

Options:
  -h, --help       Display this help and exit.
  --skip-build     Reuse an existing .tar.gz instead of running script/bundle-linux
  --native         Forward --native to script/bundle-linux (linux-native profile)
  --flatpak        Forward --flatpak to script/bundle-linux (tag system info)
  --               Stop parsing options

Environment:
  APPIMAGETOOL=/abs/path          Use this appimagetool instead of the one on PATH
  ZZZ_APPIMAGE_NAME=<name>        Override the output file name (without extension)
  ZZZ_APPIMAGE_NO_DOWNLOAD=1      Never download appimagetool when it is missing
  "
}

host_build_profile=release
bundle_args=()
skip_build=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --skip-build)
            skip_build=true
            shift
            ;;
        --native)
            host_build_profile=linux-native
            bundle_args+=(--native)
            shift
            ;;
        --flatpak)
            bundle_args+=(--flatpak)
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

case "$(uname -s)" in
    Linux) ;;
    *)
        echo "Error: AppImages can only be built on Linux." >&2
        exit 1
        ;;
esac

host_arch="$(uname -m)"
case "${host_arch}" in
    x86_64|amd64)
        appimage_arch=x86_64
        ;;
    aarch64|arm64)
        appimage_arch=aarch64
        ;;
    *)
        echo "Error: Unsupported AppImage architecture: ${host_arch}" >&2
        exit 1
        ;;
esac

target_dir="${CARGO_TARGET_DIR:-target}"
bundle_dir="${target_dir}/${host_build_profile}"

channel=$(<crates/zzz/RELEASE_CHANNEL)

suffix=""
if [[ "$channel" != "stable" ]]; then
    suffix="-$channel"
fi

case "$channel" in
    stable)
        APP_NAME="ZZZ"
        APP_ID="dev.zzz.ZZZ"
        ;;
    preview)
        APP_NAME="ZZZ Preview"
        APP_ID="dev.zzz.ZZZ-Preview"
        ;;
    nightly)
        APP_NAME="ZZZ Nightly"
        APP_ID="dev.zzz.ZZZ-Nightly"
        ;;
    dev)
        APP_NAME="ZZZ Dev"
        APP_ID="dev.zzz.ZZZ-Dev"
        ;;
    *)
        echo "Error: Invalid channel: '$channel'" >&2
        exit 1
        ;;
esac

if [[ "$skip_build" == false ]]; then
    script/bundle-linux "${bundle_args[@]}"
fi

shopt -s nullglob
candidates=("${bundle_dir}/zzz-linux-${host_arch}.tar.gz" "${bundle_dir}/zzz-"*"-linux-${host_arch}.tar.gz")
shopt -u nullglob

archive_path=""
for candidate in "${candidates[@]}"; do
    [[ -f "${candidate}" ]] || continue
    if [[ -z "${archive_path}" || "${candidate}" -nt "${archive_path}" ]]; then
        archive_path="${candidate}"
    fi
done

if [[ -z "${archive_path}" ]]; then
    echo "Error: No zzz-linux-${host_arch}.tar.gz in ${bundle_dir}. Run script/bundle-linux first." >&2
    exit 1
fi

appimagetool=""
if [[ -n "${APPIMAGETOOL:-}" ]]; then
    appimagetool="${APPIMAGETOOL}"
elif command -v appimagetool >/dev/null 2>&1; then
    appimagetool="$(command -v appimagetool)"
elif [[ "${ZZZ_APPIMAGE_NO_DOWNLOAD:-}" == "1" ]]; then
    echo "Error: appimagetool not found and ZZZ_APPIMAGE_NO_DOWNLOAD=1." >&2
    echo "Install it (e.g. from https://github.com/AppImage/appimagetool/releases) or set APPIMAGETOOL." >&2
    exit 1
else
    tool_dir="${target_dir}/appimage"
    tool_path="${tool_dir}/appimagetool-${appimage_arch}.AppImage"
    if [[ ! -x "${tool_path}" ]]; then
        echo "appimagetool not found on PATH; downloading it to ${tool_path}"
        mkdir -p "${tool_dir}"
        curl -fL -o "${tool_path}" \
            "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-${appimage_arch}.AppImage"
        chmod +x "${tool_path}"
    fi
    appimagetool="${tool_path}"
    appimage_extract_and_run=true
fi

temp_dir=$(mktemp -d)
trap 'rm -rf "${temp_dir}"' EXIT

tar -xzf "${archive_path}" -C "${temp_dir}"

shopt -s nullglob
extracted=("${temp_dir}"/*.app)
shopt -u nullglob
if [[ "${#extracted[@]}" -ne 1 ]]; then
    echo "Error: Expected exactly one .app directory in the archive, found ${#extracted[@]}." >&2
    exit 1
fi

appdir="${temp_dir}/zzz${suffix}.AppDir"
mv "${extracted[0]}" "${appdir}"

cat > "${appdir}/AppRun" <<'EOF'
#!/bin/sh
set -eu
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="${HERE}/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
exec "${HERE}/bin/zzz" "$@"
EOF
chmod +x "${appdir}/AppRun"

desktop_src="${appdir}/share/applications/${APP_ID}.desktop"
if [[ ! -f "${desktop_src}" ]]; then
    echo "Error: Missing desktop file at ${desktop_src}." >&2
    exit 1
fi
cp "${desktop_src}" "${appdir}/zzz${suffix}.desktop"

icon_src="${appdir}/share/icons/hicolor/512x512/apps/zzz.png"
if [[ ! -f "${icon_src}" ]]; then
    echo "Error: Missing icon at ${icon_src}." >&2
    exit 1
fi
ln -sf "share/icons/hicolor/512x512/apps/zzz.png" "${appdir}/zzz.png"
ln -sf "zzz.png" "${appdir}/.DirIcon"

output_name="${ZZZ_APPIMAGE_NAME:-zzz${suffix}-linux-${appimage_arch}}"
output="${bundle_dir}/${output_name}.AppImage"
rm -f "${output}"

appimagetool_args=()
if [[ "${appimage_extract_and_run:-false}" == true ]]; then
    appimagetool_args+=(--appimage-extract-and-run)
fi
ARCH="${appimage_arch}" "${appimagetool}" "${appimagetool_args[@]}" "${appdir}" "${output}"

echo "Created '${output}' (${APP_NAME})"
