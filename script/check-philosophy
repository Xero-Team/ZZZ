#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
allowlist="$root/script/philosophy-allowlist"
failures=0

check() {
    local description="$1"
    shift
    if ! "$@"; then
        echo "FAIL: $description" >&2
        failures=$((failures + 1))
    fi
}

check_default_settings() {
    rg -q '"auto_update": false' "$root/assets/settings/default.json" \
        && rg -q '"server_url": "http://127\.0\.0\.1:7331"' "$root/assets/settings/default.json" \
        && rg -q '"show_zen_models": false' "$root/assets/settings/default.json" \
        && rg -q '"auto_install_extensions"' "$root/assets/settings/default.json" \
        && ! rg -q '"auto_update_extensions"' "$root/assets/settings/default.json"
}

# Extension Gallery traffic (extensions, themes, icon themes, languages) may
# contact the public Zed marketplace. Collab server_url stays local and must
# not be reused for that gallery.
check_extension_marketplace_uses_upstream() {
    rg -q 'ZZZ_EXTENSION_MARKETPLACE_API: .*"https://api\.zed\.dev"' \
        "$root/crates/http_client/src/http_client.rs" \
        && rg -q 'build_zzz_extension_marketplace_url' \
            "$root/crates/extension_host/src/extension_host.rs" \
        && ! rg -n 'build_zzz_api_url' "$root/crates/extension_host/src/extension_host.rs"
}

check_no_telemetry_endpoint() {
    ! rg -n '/v1/log/zed' "$root/crates" "$root/script" --glob '*.rs' --glob '*.sh' --glob '*.ps1'
}

check_sentry_opt_in() {
    local file
    for file in "$root/script/bundle-linux" "$root/script/bundle-mac" "$root/script/bundle-windows.ps1"; do
        rg -q 'ZZZ_ENABLE_SENTRY_UPLOAD' "$file" || return 1
        rg -q 'SENTRY_AUTH_TOKEN' "$file" || return 1
    done
}

check_no_commercial_entrypoints() {
    ! rg -n 'start_trial|upgrade_to_zed_pro|billing-support@zed\.dev|Try Zed Pro|Start Free Trial|Upgrade to Pro|Manage Subscription' \
        "$root/crates/onboarding" "$root/crates/title_bar" \
        "$root/crates/edit_prediction_ui" "$root/crates/agent_ui"
}

check_no_commercial_identifiers() {
    ! rg -n 'start_trial|upgrade_to_zed_pro|billing-support@zed\.dev' \
        "$root/crates" "$root/assets/locales" "$root/docs/src" "$root/legal" \
        --glob '!script/check-philosophy'
}

check_help_menu() {
    ! rg -ni 'twitter|join the team|zed\.dev/docs|email us' "$root/crates/zzz/src/zzz/app_menus.rs" \
        && ! rg -ni '"menu\.help\.(zed_twitter|join_the_team|email_us)"\s*:\s*"(.*twitter|.*join the team|.*email|.*招聘)' \
            "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_locale_commercial_copy() {
    ! rg -n '"(Start Free Trial|Try Zed Pro|Upgrade to Pro|Manage Subscription|billing-support@zed\.dev)"' \
        "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_packaging_terms_are_offline() {
    ! rg -n 'billing-support@zed\.dev|hi@zed\.dev|Zed Industries|zed\.dev/pricing|Subscription Billing' \
        "$root/legal/terms.md" "$root/script/terms/terms.rtf"
}

check_no_default_cloud_hosts() {
    ! rg -n '"server_url"\s*:\s*"https://(zed\.dev|cloud\.zed\.dev|api\.zed\.dev|collab\.zed\.dev)"' \
        "$root/assets/settings/default.json"
}

check_product_defaults_no_zed_host() {
    ! rg -ni '"provider"\s*:\s*"zed\.dev"|"server_url"\s*:\s*"https?://(zed\.dev|cloud\.zed\.dev|api\.zed\.dev|collab\.zed\.dev)"' \
        "$root/assets/settings/default.json" "$root/crates/zzz/src/zzz/app_menus.rs" \
        "$root/crates/client/src/zzz_urls.rs"
}

check_product_surfaces_no_hosted_docs() {
    ! rg -n 'https?://(www\.)?zed\.dev/docs|https?://(www\.)?zed\.dev/(download|releases|pricing|account|terms)' \
        "$root/crates/zzz/src" "$root/crates/onboarding" \
        "$root/crates/title_bar" "$root/crates/edit_prediction_ui" "$root/crates/edit_prediction/src" \
        "$root/crates/agent_ui" "$root/crates/settings_ui/src" "$root/crates/language_tools/src" \
        "$root/crates/theme_selector/src" "$root/crates/debugger_ui/src" "$root/crates/repl/src" \
        "$root/crates/install_cli/src" "$root/crates/language_onboarding/src" "$root/crates/feedback/src" \
        "$root/crates/extensions_ui/src" "$root/crates/editor/src/editor.rs" \
        "$root/crates/workspace/src/notifications.rs" "$root/crates/language_models/src" \
        "$root/crates/recent_projects/src" "$root/crates/cli/src/main.rs" \
        "$root/crates/project/src/project.rs"
}

check_no_extension_feature_upsells() {
    ! rg -n 'fn render_feature_upsells|fn refresh_feature_upsells|extensions_ui.upsell\.' \
        "$root/crates/extensions_ui" "$root/assets/locales"
}

check_onboarding_has_no_plan_or_signin() {
    ! rg -n 'cloud_api_types::Plan|continue_with_zed_ai|PlanDefinitions|enum SignInStatus' \
        "$root/crates/agent_ui/src/ai_onboarding"
}

check_no_zed_business_locale() {
    ! rg -n 'welcome_zed_business|Welcome to Zed Business|welcome_zed_student|Welcome to Zed Student' \
        "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_no_discord_community() {
    ! rg -n 'discord\.gg/zed-community' "$root/docs" "$root/crates"
}

check_dev_docs_clone_this_repo() {
    ! rg -n 'Clone the \[ZZZ repository\]\(https://github.com/zed-industries/zed\)' \
        "$root/docs/src/development"
}

check_orphan_billing_docs_absent() {
    ! test -f "$root/docs/src/ai/billing.md" \
        && ! test -f "$root/docs/src/ai/subscription.md" \
        && ! test -f "$root/docs/src/ai/plans-and-usage.md" \
        && ! test -f "$root/docs/src/ai/ai-improvement.md" \
        && ! test -f "$root/docs/src/authentication.md"
}

check_cloudflare_workers_absent() {
    ! test -d "$root/.cloudflare" \
        && ! rg -n 'cloudflare/wrangler-action|deploy \.cloudflare/' \
            "$root/tooling/xtask/src/tasks/workflows/deploy_docs.rs"
}

check_open_router_no_zed_identity() {
    ! rg -n 'HTTP-Referer.*zed\.dev|X-Title.*, "Zed Editor"' "$root/crates/open_router"
}

check_keymaps_no_hosted_docs() {
    ! rg -n 'zed\.dev/docs' "$root/assets/keymaps"
}

check_privacy_documented() {
    rg -q '\./development/privacy-boundary\.md' "$root/docs/src/SUMMARY.md"
}

check_docs_auto_update_off() {
    ! rg -ni 'auto-update is on by default|By default, ZZZ checks for updates' \
        "$root/docs/src/update.md" \
        && ! rg -n 'Setting: `auto_update`' -A 3 "$root/docs/src/reference/all-settings.md" \
            | rg -q 'Default: `true`'
}

check_docs_no_zed_edit_prediction_default() {
    ! rg -n 'Default: `"zed"`' "$root/docs/src/reference/all-settings.md" \
        && ! rg -n '"provider": "zed"' "$root/docs/src/reference/all-settings.md"
}

check_docs_zeta_not_default_provider() {
    ! rg -ni 'default provider is Zeta|Zeta, ZZZ.?s (own|open-source) model|Zeta as the (default|edit prediction) provider|built-in Zeta' \
        "$root/docs/src/ai/overview.md" \
        "$root/docs/src/completions.md" \
        "$root/docs/src/ai/edit-prediction.md"
}

check_install_script_no_hosted_binaries() {
    ! rg -n 'cloud\.zed\.dev|zed\.dev/releases' "$root/script/install.sh"
}

check_privacy_policy_no_zed_industries() {
    ! rg -n 'privacy@zed\.dev|Zed Industries|opt out of Software telemetry' \
        "$root/legal/privacy-policy.md"
}

check_default_settings_no_hosted_ai() {
    ! rg -n '"zed\.dev"' "$root/assets/settings/default.json" \
        && ! rg -n 'codestral\.mistral\.ai' "$root/assets/settings/default.json" \
        && ! rg -n '"allow_data_collection": "yes"' "$root/assets/settings/default.json"
}

check_oauth_cimd_not_hosted() {
    ! rg -n 'https://zed\.dev/oauth/client-metadata\.json' \
        "$root/crates/context_server/src/oauth.rs"
}

check_no_plan_chips() {
    ! rg -n 'fn render_zed_plan_info|PlanDefinitions\.pro_plan' \
        "$root/crates/agent_ui"
}

check_collab_absent() {
    ! test -d "$root/crates/collab" \
        && ! test -d "$root/crates/collab_ui" \
        && ! test -d "$root/crates/call" \
        && ! test -d "$root/crates/channel" \
        && ! test -d "$root/crates/livekit_client" \
        && ! test -d "$root/crates/livekit_api"
}

check_no_mercury_provider() {
    ! rg -n 'EditPredictionProvider::Mercury' \
        "$root/crates/edit_prediction" "$root/crates/edit_prediction_ui" \
        "$root/crates/settings_content" "$root/crates/settings_ui"
}

check_no_zed_edit_prediction_provider() {
    ! rg -n 'EditPredictionProvider::Zed' \
        "$root/crates/edit_prediction" "$root/crates/edit_prediction_ui" \
        "$root/crates/settings_content" "$root/crates/settings_ui"
}

check_no_allow_data_collection_default() {
    ! rg -n 'allow_data_collection' "$root/assets/settings/default.json"
}

check_no_cloud_web_search() {
    ! rg -n 'CloudWebSearchProvider|ZED_WEB_SEARCH_PROVIDER_ID' \
        "$root/crates/web_search_providers" \
        && ! rg -n '"zed\.dev"' "$root/crates/web_search_providers"
}

check_no_client_signin_product_entry() {
    ! rg -n 'client::SignIn' "$root/crates/title_bar" "$root/crates/zzz/src/zzz/app_menus.rs"
}

check_no_zed_agent_configuration_target() {
    ! rg -n 'ConfigurationViewTargetAgent::ZedAgent' \
        "$root/crates/agent_ui/src/agent_configuration.rs"
}

check_no_native_agent_production_ui() {
    ! rg -n 'Agent::NativeAgent|RemovedNativeAgentServer' \
        "$root/crates/agent_ui/src" \
        --glob '!**/tests.rs' \
        --glob '!**/*_tests.rs'
}

check_no_live_zed_agent_id() {
    ! rg -n 'ZZZ_AGENT_ID' \
        "$root/crates/agent_ui/src/agent_configuration.rs" \
        && ! rg -n 'ZZZ_AGENT_ID' "$root/crates/agent_ui/src/agent_panel.rs"
}

check_registry_init_no_refresh() {
    ! rg -n 'store\.refresh\(' "$root/crates/project/src/agent_registry_store.rs"
}

# The ACP registry is refreshed only on user-initiated paths: when registry
# agents are configured (AgentServerStore::reregister_agents) or when one is
# being connected (CustomAgentServer::connect). The unconditional startup
# fetch stays absent; see check_registry_init_no_refresh.
check_registry_refresh_is_user_gated() {
    rg -U -q 'has_registry_agents\(\)[\s\S]{0,200}?refresh_if_stale' \
        "$root/crates/project/src/agent_server_store.rs" \
        && rg -U -q 'is_registry_agent[\s\S]{0,600}?refresh_if_stale' \
            "$root/crates/agent_servers/src/custom.rs"
}

check_no_unconditional_copilot_chat_init() {
    ! rg -n 'copilot_chat::init' "$root/crates/zzz/src/main.rs"
}

check_no_unconditional_copilot_chat_register() {
    ! rg -n 'register_provider\(Arc::new\(CopilotChatLanguageModelProvider' \
        "$root/crates/language_models/src/language_models.rs"
}

check_eval_clis_absent() {
    ! test -d "$root/crates/eval_cli" \
        && ! test -d "$root/crates/edit_prediction_cli"
}

check_no_telemetry_event_text() {
    ! rg -n 'fn telemetry_event_text' "$root/crates" --glob '*.rs'
}

check_no_danger_proxy() {
    ! rg -n 'danger-proxy\.zed\.dev' "$root/tooling/xtask/src/tasks/workflows/danger.rs"
}

check_no_collab_lychee() {
    ! rg -n 'collab\.zed\.dev|staging-collab\.zed\.dev' "$root/lychee.toml"
}

check_no_after_release_hosted_deploy() {
    ! rg -n 'discord-webhook|redeploy-vercel|winget-releaser|VERCEL_TOKEN|DISCORD_WEBHOOK' \
        "$root/tooling/xtask/src/tasks/workflows/after_release.rs"
}

check_hosted_release_automation_absent() {
    ! test -f "$root/script/get-released-version" \
        && ! test -f "$root/script/trigger-release" \
        && ! test -f "$root/script/trigger-docs-build" \
        && ! test -f "$root/script/redeploy-vercel" \
        && ! test -f "$root/script/bump-zed-version" \
        && ! test -f "$root/script/kube-shell" \
        && ! test -f "$root/script/digital-ocean-db.sh" \
        && ! test -f "$root/script/drop-test-dbs" \
        && ! test -f "$root/script/community-pr-track-mapping.json" \
        && ! test -f "$root/Procfile" \
        && ! test -f "$root/Procfile.web" \
        && ! test -f "$root/compose.yml" \
        && ! test -f "$root/REVIEWERS.conl"
}

check_local_backend_harness_absent() {
    ! test -f "$root/script/bootstrap" \
        && ! test -f "$root/script/bootstrap.ps1" \
        && ! test -f "$root/script/zed-local" \
        && ! test -f "$root/script/reset_db" \
        && ! test -f "$root/script/run-local-minio"
}

check_github_triage_scripts_absent() {
    ! ls "$root"/script/github-*.py >/dev/null 2>&1 \
        && ! test -f "$root/script/github-pr-status"
}

check_no_vestigial_commercial_locale_keys() {
    ! rg -n 'powered_by_zeta|built\.in\.zeta|active_subscription|subscribe_on_github|agent_ui\.end_trial|agent_ui\.agent_configuration\.plan' \
        "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_onboarding_has_no_cloud_api_types() {
    ! rg -n 'cloud_api_types' "$root/crates/onboarding/Cargo.toml" "$root/crates/onboarding/src"
}

check_title_bar_has_no_upgrade_required() {
    ! rg -n 'Status::UpgradeRequired|title_bar\.status\.upgrade_required' "$root/crates/title_bar/src"
}

check_no_hosted_cloud_provider() {
    ! test -d "$root/crates/language_models_cloud" \
        && ! test -f "$root/crates/language_models/src/provider/cloud.rs" \
        && ! rg -n 'CloudLanguageModelProvider|ZedDotDevAvailable|zed_dot_dev|language_models_cloud' \
            "$root/crates" "$root/assets/settings"
}

check_no_llm_token_api() {
    ! rg -n 'global_llm_token|RefreshLlmTokenListener|LlmApiToken|acquire_llm_token|refresh_llm_token|clear_and_refresh_llm_token|NeedsLlmTokenRefresh|EditPredictionUsage' \
        "$root/crates" --glob '*.rs'
}

check_no_account_fetch_in_user_store() {
    ! rg -n 'get_authenticated_user|update_authenticated_user|submit_edit_prediction_feedback' \
        "$root/crates/client/src/user.rs" "$root/crates/edit_prediction/src"
}

check_no_agent_feedback_upload() {
    ! rg -n 'submit_agent_feedback|submit_agent_feedback_comments|/client/feedback/agent_thread' \
        "$root/crates" --glob '*.rs' \
        && ! rg -n '"enable_feedback"|agent\.enable_feedback' \
            "$root/assets/settings/default.json" "$root/crates/settings_ui/src" \
        && ! rg -n 'enable_feedback' \
            "$root/crates/agent_settings/src" "$root/crates/settings_content/src" \
        && ! rg -n 'agent_ui\.thread_view\.feedback|agent_ui\.inline_prompt\.(good_result|bad_result|cant_rate_still_generating|already_rated|click_to_copy_rating_id)' \
            "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_no_cloud_websocket() {
    ! rg -n 'connect_to_cloud|run_cloud_connection|MessageToClientHandler|add_message_to_client_handler|MessageToClient|websocket_protocol' \
        "$root/crates" --glob '*.rs' \
        && ! test -f "$root/crates/cloud_api_client/src/websocket.rs" \
        && ! test -f "$root/crates/cloud_api_types/src/websocket_protocol.rs"
}

check_no_impersonation_backdoor() {
    ! rg -n 'IMPERSONATE_LOGIN|ADMIN_API_TOKEN|USE_WEB_LOGIN|authenticate_as_admin|/internal/users/impersonate' \
        "$root/crates" --glob '*.rs'
}

check_no_collab_ui_components() {
    ! test -d "$root/crates/ui/src/components/collab" \
        && ! test -f "$root/crates/ui/src/components/collab.rs"
}

check_no_inline_rating_actions() {
    ! rg -n 'ThumbsUpResult|ThumbsDownResult|CompletionState::Rated' \
        "$root/crates" "$root/assets/keymaps" --glob '*.rs' --glob '*.json'
}

check_no_account_signin_flow() {
    ! rg -n 'native_app_signin|authenticate_with_browser' "$root/crates" --glob '*.rs' \
        && ! rg -n 'sign_out_tx|request_sign_out|validate_credentials' "$root/crates/client/src" \
        && ! rg -n 'SignIn|SignOut' "$root/crates/client/src/client.rs"
}

check_no_cloud_api_client() {
    ! test -d "$root/crates/cloud_api_client" \
        && ! rg -n 'cloud_api_client|CloudApiClient|cloud_client' "$root/crates" --glob '*.rs' --glob 'Cargo.toml' \
        && ! rg -n 'cloud_api_client' "$root/Cargo.toml"
}

check_no_internal_user_api() {
    ! test -f "$root/crates/cloud_api_types/src/internal_api.rs" \
        && ! rg -n 'internal_api|FuzzySearchUsersBody|LookUpUserByGithubLogin|ChannelMember' \
            "$root/crates/cloud_api_types" --glob '*.rs'
}

check_orphan_and_telemetry_dirs_absent() {
    ! test -d "$root/crates/crashes" \
        && ! test -f "$root/crates/client/src/telemetry.rs"
}

check_allowlisted_hosts() {
    local urls
    urls=$(rg --no-filename -o 'https?://[^"` )]+' "$root/assets/settings/default.json" "$root/crates/client/src/client.rs" \
        2>/dev/null | sed -E 's#https?://([^/:]+).*#\1#; s/[][{}]//g' | sort -u)
    while read -r host; do
        [[ -z "$host" ]] && continue
        if ! rg -qxF "$host" "$allowlist"; then
            echo "host is not registered in script/philosophy-allowlist: $host" >&2
            return 1
        fi
    done <<< "$urls"
}

check "default settings are local-first" check_default_settings
check "extension gallery uses the upstream marketplace" check_extension_marketplace_uses_upstream
check "telemetry endpoint is absent" check_no_telemetry_endpoint
check "Sentry uploads require explicit opt-in" check_sentry_opt_in
check "commercial entry points are absent" check_no_commercial_entrypoints
check "commercial identifiers are absent from product surfaces" check_no_commercial_identifiers
check "Help menu has no commercial links" check_help_menu
check "locale has no commercial copy" check_locale_commercial_copy
check "packaging terms are offline and non-commercial" check_packaging_terms_are_offline
check "default cloud hosts are absent" check_no_default_cloud_hosts
check "product defaults do not reference hosted ZZZ hosts" check_product_defaults_no_zed_host
check "product surfaces have no hosted documentation links" check_product_surfaces_no_hosted_docs
check "extension gallery has no feature upsell banners" check_no_extension_feature_upsells
check "AI onboarding has no plan or sign-in types" check_onboarding_has_no_plan_or_signin
check "locales have no Zed Business or Student welcome copy" check_no_zed_business_locale
check "docs have no Discord community invite" check_no_discord_community
check "development clone URLs point at this repository" check_dev_docs_clone_this_repo
check "orphan billing and account docs are absent" check_orphan_billing_docs_absent
check "Cloudflare hosted-docs workers are absent" check_cloudflare_workers_absent
check "OpenRouter requests do not identify as Zed" check_open_router_no_zed_identity
check "default keymaps do not point at hosted docs" check_keymaps_no_hosted_docs
check "privacy boundary is linked from documentation summary" check_privacy_documented
check "docs do not say auto-update is on by default" check_docs_auto_update_off
check "docs do not default edit prediction provider to zed" check_docs_no_zed_edit_prediction_default
check "docs do not call Zeta the default provider" check_docs_zeta_not_default_provider
check "install script does not download hosted binaries" check_install_script_no_hosted_binaries
check "privacy policy has no Zed Industries telemetry opt-out" check_privacy_policy_no_zed_industries
check "default settings have no hosted AI collection" check_default_settings_no_hosted_ai
check "MCP OAuth CIMD is not a hosted zed.dev URL" check_oauth_cimd_not_hosted
check "plan chips are absent from onboarding and agent UI" check_no_plan_chips
check "multi-user collab crates are absent" check_collab_absent
check "Mercury edit prediction provider is absent" check_no_mercury_provider
check "hosted Zed edit prediction provider is absent" check_no_zed_edit_prediction_provider
check "default settings have no allow_data_collection" check_no_allow_data_collection_default
