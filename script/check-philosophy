check "client SignIn is absent from title bar and app menus" check_no_client_signin_product_entry
check "agent configuration does not default to ZedAgent" check_no_zed_agent_configuration_target
check "NativeAgent is absent from production agent UI" check_no_native_agent_production_ui
check "ZZZ_AGENT_ID is not a live selectable agent" check_no_live_zed_agent_id
check "agent registry init does not refresh when empty" check_registry_init_no_refresh
check "agent registry refresh is gated on user configuration" check_registry_refresh_is_user_gated
check "copilot_chat::init is not unconditional in main.rs" check_no_unconditional_copilot_chat_init
check "CopilotChatLanguageModelProvider is not registered at language_models init" check_no_unconditional_copilot_chat_register
check "eval_cli and edit_prediction_cli directories are absent" check_eval_clis_absent
check "Item::telemetry_event_text is absent" check_no_telemetry_event_text
check "Danger GitHub API proxy host is absent" check_no_danger_proxy
check "lychee.toml has no collab hosts" check_no_collab_lychee
check "after_release has no hosted Discord/Vercel/winget deploy" check_no_after_release_hosted_deploy
check "hosted release and deploy automation is absent" check_hosted_release_automation_absent
check "local backend and collab harness is absent" check_local_backend_harness_absent
check "GitHub triage scripts are absent" check_github_triage_scripts_absent
check "no vestigial commercial locale keys remain" check_no_vestigial_commercial_locale_keys
check "onboarding has no cloud_api_types dependency" check_onboarding_has_no_cloud_api_types
check "title bar has no upgrade-required collab status" check_title_bar_has_no_upgrade_required
check "hosted cloud language model provider is absent" check_no_hosted_cloud_provider
check "LLM token and edit prediction usage APIs are absent" check_no_llm_token_api
check "user store does not fetch account data" check_no_account_fetch_in_user_store
check "agent feedback upload surface is absent" check_no_agent_feedback_upload
check "hosted cloud websocket is absent" check_no_cloud_websocket
check "admin impersonation backdoor is absent" check_no_impersonation_backdoor
check "collab UI components are absent" check_no_collab_ui_components
check "inline prompt rating actions are absent" check_no_inline_rating_actions
check "account sign-in flow is absent" check_no_account_signin_flow
check "cloud API client crate is absent" check_no_cloud_api_client
check "internal user search API is absent" check_no_internal_user_api
check "orphan and telemetry directories are absent" check_orphan_and_telemetry_dirs_absent
check "network hosts are allowlisted" check_allowlisted_hosts

if (( failures > 0 )); then
    echo "philosophy check failed with $failures violation(s)" >&2
    exit 1
fi
echo "philosophy check passed"
