#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
allowlist="$root/script/philosophy-allowlist"
failures=0

check() {
    local description="$1"
    shift
    if ! "$@"; then
        echo "FAIL: $description" >&2
        failures=$((failures + 1))
    fi
}

check_default_settings() {
    rg -q '"auto_update": false' "$root/assets/settings/default.json" \
        && rg -q '"server_url": "http://127\.0\.0\.1:7331"' "$root/assets/settings/default.json" \
        && rg -q '"show_zen_models": false' "$root/assets/settings/default.json" \
        && ! rg -q '"auto_install_extensions"' "$root/assets/settings/default.json" \
        && ! rg -q '"auto_update_extensions"' "$root/assets/settings/default.json"
}

check_no_automatic_extension_network() {
    ! rg -n 'fn auto_install_extensions|fn check_for_updates|fn fetch_extensions_with_update_available' \
        "$root/crates/extension_host/src"
}

# User-initiated Extension Gallery traffic (extensions, themes, icon themes,
# languages) may contact the public Zed marketplace. Collab server_url stays
# local and must not be reused for that gallery.
check_extension_marketplace_uses_upstream() {
    rg -q 'ZED_EXTENSION_MARKETPLACE_API: .*"https://api\.zed\.dev"' \
        "$root/crates/http_client/src/http_client.rs" \
        && rg -q 'build_zed_extension_marketplace_url' \
            "$root/crates/extension_host/src/extension_host.rs" \
        && ! rg -n 'build_zed_api_url' "$root/crates/extension_host/src/extension_host.rs"
}

check_no_telemetry_endpoint() {
    ! rg -n '/v1/log/zed' "$root/crates" "$root/script" --glob '*.rs' --glob '*.sh' --glob '*.ps1'
}

check_sentry_opt_in() {
    local file
    for file in "$root/script/bundle-linux" "$root/script/bundle-mac" "$root/script/bundle-windows.ps1"; do
        rg -q 'ZZZ_ENABLE_SENTRY_UPLOAD' "$file" || return 1
        rg -q 'SENTRY_AUTH_TOKEN' "$file" || return 1
    done
}

check_no_commercial_entrypoints() {
    ! rg -n 'start_trial|upgrade_to_zed_pro|billing-support@zed\.dev|Try Zed Pro|Start Free Trial|Upgrade to Pro|Manage Subscription' \
        "$root/crates/ai_onboarding" "$root/crates/onboarding" "$root/crates/title_bar" \
        "$root/crates/edit_prediction_ui" "$root/crates/agent_ui" "$root/crates/language_models/src/provider/cloud.rs"
}

check_no_commercial_identifiers() {
    ! rg -n 'start_trial|upgrade_to_zed_pro|billing-support@zed\.dev' \
        "$root/crates" "$root/assets/locales" "$root/docs/src" "$root/legal" \
        --glob '!script/check-philosophy'
}

check_help_menu() {
    ! rg -ni 'twitter|join the team|zed\.dev/docs|email us' "$root/crates/zed/src/zed/app_menus.rs" \
        && ! rg -ni '"menu\.help\.(zed_twitter|join_the_team|email_us)"\s*:\s*"(.*twitter|.*join the team|.*email|.*招聘)' \
            "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_locale_commercial_copy() {
    ! rg -n '"(Start Free Trial|Try Zed Pro|Upgrade to Pro|Manage Subscription|billing-support@zed\.dev)"' \
        "$root/assets/locales/en.json" "$root/assets/locales/zh-CN.json"
}

check_packaging_terms_are_offline() {
    ! rg -n 'billing-support@zed\.dev|hi@zed\.dev|Zed Industries|zed\.dev/pricing|Subscription Billing' \
        "$root/legal/terms.md" "$root/script/terms/terms.rtf"
}

check_no_default_cloud_hosts() {
    ! rg -n '"server_url"\s*:\s*"https://(zed\.dev|cloud\.zed\.dev|api\.zed\.dev|collab\.zed\.dev)"' \
        "$root/assets/settings/default.json"
}

check_product_defaults_no_zed_host() {
    ! rg -ni '"provider"\s*:\s*"zed\.dev"|"server_url"\s*:\s*"https?://(zed\.dev|cloud\.zed\.dev|api\.zed\.dev|collab\.zed\.dev)"' \
        "$root/assets/settings/default.json" "$root/crates/zed/src/zed/app_menus.rs" \
        "$root/crates/client/src/zed_urls.rs"
}

check_product_surfaces_no_hosted_docs() {
    ! rg -n 'https?://(www\.)?zed\.dev/docs|https?://(www\.)?zed\.dev/(download|releases|pricing|account|terms)' \
        "$root/crates/zed/src" "$root/crates/ai_onboarding" "$root/crates/onboarding" \
        "$root/crates/title_bar" "$root/crates/edit_prediction_ui" "$root/crates/edit_prediction/src" \
        "$root/crates/agent_ui" "$root/crates/settings_ui/src" "$root/crates/language_tools/src" \
        "$root/crates/theme_selector/src" "$root/crates/debugger_ui/src" "$root/crates/repl/src" \
        "$root/crates/install_cli/src" "$root/crates/language_onboarding/src" "$root/crates/feedback/src"
}

check_privacy_documented() {
    rg -q '\./development/privacy-boundary\.md' "$root/docs/src/SUMMARY.md"
}

check_docs_auto_update_off() {
    ! rg -ni 'auto-update is on by default|By default, ZZZ checks for updates' \
        "$root/docs/src/update.md" \
        && ! rg -n 'Setting: `auto_update`' -A 3 "$root/docs/src/reference/all-settings.md" \
            | rg -q 'Default: `true`'
}

check_docs_no_zed_edit_prediction_default() {
    ! rg -n 'Default: `"zed"`' "$root/docs/src/reference/all-settings.md" \
        && ! rg -n '"provider": "zed"' "$root/docs/src/reference/all-settings.md"
}

check_docs_zeta_not_default_provider() {
    ! rg -ni 'default provider is Zeta|Zeta, ZZZ.?s (own|open-source) model|Zeta as the (default|edit prediction) provider|built-in Zeta' \
        "$root/docs/src/ai/overview.md" \
        "$root/docs/src/completions.md" \
        "$root/docs/src/ai/edit-prediction.md"
}

check_install_script_no_hosted_binaries() {
    ! rg -n 'cloud\.zed\.dev|zed\.dev/releases' "$root/script/install.sh"
}

check_privacy_policy_no_zed_industries() {
    ! rg -n 'privacy@zed\.dev|Zed Industries|opt out of Software telemetry' \
        "$root/legal/privacy-policy.md"
}

check_default_settings_no_hosted_ai() {
    ! rg -n '"zed\.dev"' "$root/assets/settings/default.json" \
        && ! rg -n 'codestral\.mistral\.ai' "$root/assets/settings/default.json" \
        && ! rg -n '"allow_data_collection": "yes"' "$root/assets/settings/default.json"
}

check_oauth_cimd_not_hosted() {
    ! rg -n 'https://zed\.dev/oauth/client-metadata\.json' \
        "$root/crates/context_server/src/oauth.rs"
}

check_no_plan_chips() {
    ! rg -n 'fn render_zed_plan_info|PlanDefinitions\.pro_plan' \
        "$root/crates/ai_onboarding" "$root/crates/agent_ui"
}

check_collab_signed_out_no_github() {
    ! rg -n 'Sign In with GitHub' "$root/crates/collab_ui"
}

check_allowlisted_hosts() {
    local urls
    urls=$(rg --no-filename -o 'https?://[^"` )]+' "$root/assets/settings/default.json" "$root/crates/client/src/client.rs" \
        "$root/crates/cloud_api_client/src" 2>/dev/null | sed -E 's#https?://([^/:]+).*#\1#; s/[][{}]//g' | sort -u)
    while read -r host; do
        [[ -z "$host" ]] && continue
        if ! rg -qxF "$host" "$allowlist"; then
            echo "host is not registered in script/philosophy-allowlist: $host" >&2
            return 1
        fi
    done <<< "$urls"
}

check "default settings are local-first" check_default_settings
check "extensions are not installed or updated automatically" check_no_automatic_extension_network
check "extension gallery uses the upstream marketplace" check_extension_marketplace_uses_upstream
check "telemetry endpoint is absent" check_no_telemetry_endpoint
check "Sentry uploads require explicit opt-in" check_sentry_opt_in
check "commercial entry points are absent" check_no_commercial_entrypoints
check "commercial identifiers are absent from product surfaces" check_no_commercial_identifiers
check "Help menu has no commercial links" check_help_menu
check "locale has no commercial copy" check_locale_commercial_copy
check "packaging terms are offline and non-commercial" check_packaging_terms_are_offline
check "default cloud hosts are absent" check_no_default_cloud_hosts
check "product defaults do not reference hosted ZZZ hosts" check_product_defaults_no_zed_host
check "product surfaces have no hosted documentation links" check_product_surfaces_no_hosted_docs
check "privacy boundary is linked from documentation summary" check_privacy_documented
check "docs do not say auto-update is on by default" check_docs_auto_update_off
check "docs do not default edit prediction provider to zed" check_docs_no_zed_edit_prediction_default
check "docs do not call Zeta the default provider" check_docs_zeta_not_default_provider
check "install script does not download hosted binaries" check_install_script_no_hosted_binaries
check "privacy policy has no Zed Industries telemetry opt-out" check_privacy_policy_no_zed_industries
check "default settings have no hosted AI collection" check_default_settings_no_hosted_ai
check "MCP OAuth CIMD is not a hosted zed.dev URL" check_oauth_cimd_not_hosted
check "plan chips are absent from onboarding and agent UI" check_no_plan_chips
check "collab signed-out panel has no GitHub sign-in" check_collab_signed_out_no_github
check "network hosts are allowlisted" check_allowlisted_hosts

if (( failures > 0 )); then
    echo "philosophy check failed with $failures violation(s)" >&2
    exit 1
fi
echo "philosophy check passed"
