#!/usr/bin/env bash

set -euxo pipefail
source script/lib/blob-store.sh

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz for Linux.

When Zig and cargo-zigbuild are available, the bundle also embeds macOS
x86_64 and aarch64 remote_server archives for SSH remote development.

Options:
  -h, --help     Display this help and exit.
  --flatpak      Set ZZZ_BUNDLE_TYPE=flatpak so that this can be included in system info
  --native       Build the local app with the linux-native profile and target-cpu=native
  --deb          Also generate a Debian package with cargo-deb
  --rpm          Also generate an RPM package with cargo-generate-rpm

Environment:
  ZZZ_PGO_GENERATE_DIR=/abs/dir   Build host binaries with PGO instrumentation into this directory
  ZZZ_PGO_PROFILE=/abs/file       Build host binaries using this merged .profdata file
  ZZZ_BOLT_PREPARE=1              Build host binary with relocation info for later perf2bolt/llvm-bolt use
  ZZZ_BOLT_INSTRUMENT_FILE=/abs/file  Build an instrumented host binary that writes BOLT .fdata here
  ZZZ_BOLT_PERF=/abs/file         Build host binary, then optimize it with BOLT using this perf.data
  ZZZ_BOLT_FDATA=/abs/file        Build host binary, then optimize it with BOLT using this .fdata
  ZZZ_BUILD_JOBS=<n>              Number of parallel Cargo jobs (defaults to host CPU count)
  ZZZ_CROSS_BUILD_JOBS=<n>        Jobs per optional cross-target build (defaults to half)
  ZZZ_CARGO_DEB_VERSION=3.8.0     Required cargo-deb version when --deb is used
  ZZZ_CARGO_GENERATE_RPM_VERSION=0.21.0  Required cargo-generate-rpm version when --rpm is used
  "
}

host_build_profile=release
host_build_native=false
package_deb=false
package_rpm=false

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export ZZZ_BUNDLE_TYPE=flatpak
            shift
            ;;
        --native)
            host_build_profile=linux-native
            host_build_native=true
            shift
            ;;
        --deb)
            package_deb=true
            shift
            ;;
        --rpm)
            package_rpm=true
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

export ZZZ_BUNDLE=true

channel=$(<crates/zzz/RELEASE_CHANNEL)
target_dir="${CARGO_TARGET_DIR:-target}"
host_artifact_dir=""
remote_artifact_dir=""
bundle_artifact_dir="${target_dir}/${host_build_profile}"
pgo_generate_dir="${ZZZ_PGO_GENERATE_DIR:-}"
pgo_profile="${ZZZ_PGO_PROFILE:-}"
bolt_prepare="${ZZZ_BOLT_PREPARE:-}"
bolt_instrument_file="${ZZZ_BOLT_INSTRUMENT_FILE:-}"
bolt_perf="${ZZZ_BOLT_PERF:-}"
bolt_fdata="${ZZZ_BOLT_FDATA:-}"

if [[ -z "${CARGO_BUILD_JOBS:-}" ]]; then
    if command -v getconf >/dev/null 2>&1; then
        CARGO_BUILD_JOBS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
    elif command -v nproc >/dev/null 2>&1; then
        CARGO_BUILD_JOBS="$(nproc)"
    fi
    CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
    export CARGO_BUILD_JOBS
fi
cross_build_jobs="${ZZZ_CROSS_BUILD_JOBS:-$(( (CARGO_BUILD_JOBS + 1) / 2 ))}"

case "$channel" in
    stable|preview|nightly|dev) package_variant="$channel" ;;
    *) package_variant=dev ;;
esac

if [[ "$package_deb" == true ]] && ! command -v cargo-deb >/dev/null 2>&1; then
    echo "Error: --deb requires cargo-deb on PATH; install it before running bundle-linux." >&2
    exit 1
fi
if [[ "$package_deb" == true ]]; then
    cargo_deb_version="${ZZZ_CARGO_DEB_VERSION:-3.8.0}"
    if [[ "$(cargo-deb --version | awk '{print $2}')" != "$cargo_deb_version" ]]; then
        echo "Error: cargo-deb ${cargo_deb_version} is required." >&2
        exit 1
    fi
fi
if [[ "$package_rpm" == true ]] && ! command -v cargo-generate-rpm >/dev/null 2>&1; then
    echo "Error: --rpm requires cargo-generate-rpm 0.21.0 on PATH." >&2
    echo "Install it with: cargo install cargo-generate-rpm --version 0.21.0 --locked" >&2
    exit 1
fi
if [[ "$package_rpm" == true ]]; then
    cargo_generate_rpm_version="${ZZZ_CARGO_GENERATE_RPM_VERSION:-0.21.0}"
    if [[ "$(cargo-generate-rpm --version | awk '{print $2}')" != "$cargo_generate_rpm_version" ]]; then
        echo "Error: cargo-generate-rpm ${cargo_generate_rpm_version} is required." >&2
        exit 1
    fi
fi

expected_tree_sitter_version="$(sed -n 's/^tree-sitter-cli-version = "\([^"]*\)"/\1/p' crates/grammars/vendor/manifest.toml)"
actual_tree_sitter_version="$(tree-sitter --version 2>/dev/null | awk '{print $2}' || true)"
if [[ -z "$expected_tree_sitter_version" || "$actual_tree_sitter_version" != "$expected_tree_sitter_version" ]]; then
    echo "Error: tree-sitter ${expected_tree_sitter_version} is required; found ${actual_tree_sitter_version:-missing}." >&2
    echo "Install it with: cargo install --locked --version ${expected_tree_sitter_version} tree-sitter-cli" >&2
    exit 1
fi

cargo xtask grammars generate

version="$(script/get-crate-version zzz)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
musl_triple=${target_triple%-gnu}-musl
remote_server_triple=${REMOTE_SERVER_TARGET:-"${musl_triple}"}
rustup_installed=false
if command -v rustup >/dev/null 2>&1; then
    rustup_installed=true
fi

rust_target_is_installed() {
    if [[ "$rustup_installed" == true ]]; then
        rustup target list --installed | grep -qx "$1"
    else
        # Non-rustup toolchains may provide targets through their own
        # installation mechanism. Cargo will report a useful linker error if
        # the target is unavailable.
        return 0
    fi
}

if [[ -n "${pgo_generate_dir}" && -n "${pgo_profile}" ]]; then
    echo "Error: ZZZ_PGO_GENERATE_DIR and ZZZ_PGO_PROFILE are mutually exclusive" >&2
    exit 1
fi

bolt_mode_count=0
if [[ -n "${bolt_instrument_file}" ]]; then
    bolt_mode_count=$((bolt_mode_count + 1))
fi
if [[ -n "${bolt_perf}" ]]; then
    bolt_mode_count=$((bolt_mode_count + 1))
fi
if [[ -n "${bolt_fdata}" ]]; then
    bolt_mode_count=$((bolt_mode_count + 1))
fi
if (( bolt_mode_count > 1 )); then
    echo "Error: Choose only one of ZZZ_BOLT_INSTRUMENT_FILE, ZZZ_BOLT_PERF, or ZZZ_BOLT_FDATA" >&2
    exit 1
fi

if [[ -n "${pgo_generate_dir}" && "${pgo_generate_dir}" != /* ]]; then
    echo "Error: ZZZ_PGO_GENERATE_DIR must be an absolute path" >&2
    exit 1
fi

if [[ "${pgo_generate_dir}" == "/" ]]; then
    echo "Error: ZZZ_PGO_GENERATE_DIR cannot be /" >&2
    exit 1
fi

if [[ -n "${pgo_profile}" && "${pgo_profile}" != /* ]]; then
    echo "Error: ZZZ_PGO_PROFILE must be an absolute path" >&2
    exit 1
fi

if [[ -n "${pgo_profile}" && ! -f "${pgo_profile}" ]]; then
    echo "Error: ZZZ_PGO_PROFILE does not exist: ${pgo_profile}" >&2
    exit 1
fi

if [[ -n "${bolt_instrument_file}" && "${bolt_instrument_file}" != /* ]]; then
    echo "Error: ZZZ_BOLT_INSTRUMENT_FILE must be an absolute path" >&2
    exit 1
fi

if [[ -n "${bolt_perf}" && "${bolt_perf}" != /* ]]; then
    echo "Error: ZZZ_BOLT_PERF must be an absolute path" >&2
    exit 1
fi

if [[ -n "${bolt_fdata}" && "${bolt_fdata}" != /* ]]; then
    echo "Error: ZZZ_BOLT_FDATA must be an absolute path" >&2
    exit 1
fi

if [[ -n "${bolt_perf}" && ! -f "${bolt_perf}" ]]; then
    echo "Error: ZZZ_BOLT_PERF does not exist: ${bolt_perf}" >&2
    exit 1
fi

if [[ -n "${bolt_fdata}" && ! -f "${bolt_fdata}" ]]; then
    echo "Error: ZZZ_BOLT_FDATA does not exist: ${bolt_fdata}" >&2
    exit 1
fi

if [[ -n "${bolt_instrument_file}" || -n "${bolt_perf}" || -n "${bolt_fdata}" ]]; then
    if ! command -v llvm-bolt >/dev/null 2>&1; then
        echo "Error: llvm-bolt is required for BOLT workflows" >&2
        exit 1
    fi
fi

if [[ -n "${bolt_perf}" ]] && ! command -v perf2bolt >/dev/null 2>&1; then
    echo "Error: perf2bolt is required when ZZZ_BOLT_PERF is set" >&2
    exit 1
fi

if [[ -z "${FFMPEG_DIR:-}" ]]; then
    FFMPEG_DIR="$(script/ffmpeg ensure --target "${target_triple}")"
    export FFMPEG_DIR
fi
if [[ ! -f "${FFMPEG_DIR}/include/libavcodec/avcodec.h" || ! -d "${FFMPEG_DIR}/lib" ]]; then
    echo "Error: FFmpeg development package is incomplete: ${FFMPEG_DIR}" >&2
    exit 1
fi

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

if ! rust_target_is_installed "$remote_server_triple"; then
    echo "Error: Rust target ${remote_server_triple} is not installed; install it before building." >&2
    exit 1
fi

export CC=${CC:-$(which clang)}

# Build binary in release mode
# We need lld to link libwebrtc.a successfully on aarch64-linux.
# NOTE: Since RUSTFLAGS env var overrides all .cargo/config.toml rustflags
# (see https://github.com/rust-lang/cargo/issues/5376), the
# [target.aarch64-unknown-linux-gnu] section in config.toml has no effect here.
base_rustflags="${RUSTFLAGS:-}"
if [[ "$(uname -m)" == "aarch64" ]]; then
    link_rustflags=" -C link-arg=-fuse-ld=lld -C link-args=-Wl,--disable-new-dtags,-rpath,\$ORIGIN/../lib"
else
    link_rustflags=" -C link-args=-Wl,--disable-new-dtags,-rpath,\$ORIGIN/../lib"
fi
if [[ -n "${bolt_prepare}" || -n "${bolt_instrument_file}" || -n "${bolt_perf}" || -n "${bolt_fdata}" ]]; then
    link_rustflags="${link_rustflags},--emit-relocs,-znow"
fi

host_cargo_args=(--release)
if [[ "$host_build_profile" != "release" ]]; then
    host_cargo_args=(--profile "$host_build_profile")
fi
host_rustflags="${base_rustflags}${link_rustflags}"
if [[ "$host_build_native" == true ]]; then
    host_rustflags="${host_rustflags} -C target-cpu=native"
fi
if [[ -n "${pgo_generate_dir}" ]]; then
    mkdir -p "${pgo_generate_dir}"
    find "${pgo_generate_dir}" -maxdepth 1 -type f -name '*.profraw' -delete
    host_rustflags="${host_rustflags} -Cprofile-generate=${pgo_generate_dir}"
fi
if [[ -n "${pgo_profile}" ]]; then
    host_rustflags="${host_rustflags} -Cprofile-use=${pgo_profile} -Cllvm-args=-pgo-warn-missing-function"
fi

# Build remote_server archives before the editor so they can be embedded.
mkdir -p "${target_dir}"
optional_remote_pids=()

wait_for_optional_remote_builds() {
    local status=0
    local pid
    for pid in "${optional_remote_pids[@]}"; do
        if ! wait "$pid"; then
            status=1
        fi
    done
    optional_remote_pids=()
    return "$status"
}

remote_rustflags="${base_rustflags}"
if [[ "$remote_server_triple" == "$musl_triple" ]]; then
    remote_rustflags="${remote_rustflags} -C target-feature=+crt-static"
    remote_cc_variable="CC_${remote_server_triple//-/_}"
    remote_cc="${!remote_cc_variable:-}"
    if [[ -z "$remote_cc" ]]; then
        musl_cc="${remote_server_triple%%-unknown-linux-musl}-linux-musl-gcc"
        if command -v "$musl_cc" >/dev/null 2>&1; then
            remote_cc="$(command -v "$musl_cc")"
        elif command -v musl-gcc >/dev/null 2>&1; then
            remote_cc="$(command -v musl-gcc)"
        else
            echo "Error: a musl C compiler is required to build remote_server for ${remote_server_triple}" >&2
            exit 1
        fi
    fi
    export "$remote_cc_variable=$remote_cc"
fi
export RUSTFLAGS="${remote_rustflags}"
export ZZZ_BUILDING_REMOTE_SERVER=1
cargo build --release --target "${remote_server_triple}" --package remote_server
remote_artifact_dir="${target_dir}/${remote_server_triple}/release"
remote_server_arch="${remote_server_triple%%-*}"
gzip -f --stdout --best "${remote_artifact_dir}/remote_server" \
    > "${target_dir}/zzz-remote-server-linux-${remote_server_arch}.gz"

if [[ "$remote_server_triple" != "aarch64-unknown-linux-musl" ]] \
    && command -v zig >/dev/null 2>&1 \
    && command -v cargo-zigbuild >/dev/null 2>&1; then
    if ! rust_target_is_installed aarch64-unknown-linux-musl; then
        echo "Info: skipped aarch64 remote_server embed; Rust target is not installed."
    else
        export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-/tmp/zzz-zig-cache}"
        aarch64_zig_local_cache_dir="${ZIG_GLOBAL_CACHE_DIR}/aarch64-unknown-linux-musl"
        mkdir -p "$aarch64_zig_local_cache_dir"
        rm -rf "${target_dir}/aarch64-unknown-linux-musl/release/build"/aws-lc-sys-*
        rm -rf "${target_dir}/aarch64-unknown-linux-musl/release/.fingerprint"/aws-lc-sys-*
        rm -f "${target_dir}/aarch64-unknown-linux-musl/release/deps"/libaws_lc*
        # rustc passes `-O1` to the linker on optimized builds; Zig's cc wrapper
        # reports it as a deprecated setting (rust-lang/rust#158192), so allow the
        # resulting false-positive linker message.
        (
            if ZIG_LOCAL_CACHE_DIR="$aarch64_zig_local_cache_dir" \
                CARGO_BUILD_JOBS="$cross_build_jobs" \
                RUSTFLAGS="${RUSTFLAGS} -A linker_messages" \
                cargo zigbuild --release --target aarch64-unknown-linux-musl --package remote_server; then
                gzip -f --stdout --best "${target_dir}/aarch64-unknown-linux-musl/release/remote_server" \
                    > "${target_dir}/zzz-remote-server-linux-aarch64.gz"
            else
                echo "Info: skipped aarch64 remote_server embed; zigbuild failed."
            fi
        ) &
        optional_remote_pids+=("$!")
    fi
fi

build_macos_remote_server() {
    local macos_triple="$1"
    local macos_arch="$2"
    if ! rust_target_is_installed "$macos_triple"; then
        echo "Info: skipped ${macos_triple} remote_server embed; Rust target is not installed."
        return 0
    fi
    rm -rf "${target_dir}/${macos_triple}/release/build"/aws-lc-sys-*
    rm -rf "${target_dir}/${macos_triple}/release/.fingerprint"/aws-lc-sys-*
    rm -f "${target_dir}/${macos_triple}/release/deps"/libaws_lc*
    echo "Compiling remote_server for ${macos_triple}"
    local zig_local_cache_dir="${ZIG_GLOBAL_CACHE_DIR}/${macos_triple}"
    mkdir -p "$zig_local_cache_dir"
    if ZIG_LOCAL_CACHE_DIR="$zig_local_cache_dir" CARGO_BUILD_JOBS="$cross_build_jobs" \
        cargo zigbuild --release --package remote_server \
        --target-dir "${target_dir}" --target "$macos_triple"; then
        gzip -f --stdout --best "${target_dir}/${macos_triple}/release/remote_server" \
            > "${target_dir}/zzz-remote-server-macos-${macos_arch}.gz"
    else
        echo "Info: skipped ${macos_triple} remote_server embed; zigbuild failed."
    fi
}

if command -v zig >/dev/null 2>&1 && command -v cargo-zigbuild >/dev/null 2>&1; then
    export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-/tmp/zzz-zig-cache}"
    mkdir -p "${ZIG_GLOBAL_CACHE_DIR}"

    saved_cxxflags="${CXXFLAGS:-}"
    saved_sdkroot="${SDKROOT:-}"
    saved_rustflags="${RUSTFLAGS:-}"
    unset CXXFLAGS
    if macos_sdkroot="$(script/ensure-macos-sdk)"; then
        export SDKROOT="${macos_sdkroot}"
        export RUSTFLAGS="${base_rustflags} -A linker_messages"
        build_macos_remote_server x86_64-apple-darwin x86_64 &
        optional_remote_pids+=("$!")
        build_macos_remote_server aarch64-apple-darwin aarch64 &
        optional_remote_pids+=("$!")
    else
        echo "Info: skipped macOS remote_server embeds; macOS SDK preparation failed."
    fi
    if [[ -n "${saved_cxxflags}" ]]; then
        export CXXFLAGS="${saved_cxxflags}"
    else
        unset CXXFLAGS
    fi
    if [[ -n "${saved_sdkroot}" ]]; then
        export SDKROOT="${saved_sdkroot}"
    else
        unset SDKROOT
    fi
    if [[ -n "${saved_rustflags}" ]]; then
        export RUSTFLAGS="${saved_rustflags}"
    else
        unset RUSTFLAGS
    fi
fi
wait_for_optional_remote_builds
unset ZZZ_BUILDING_REMOTE_SERVER

zzz_embed_remote_server_dir="$(cd "${target_dir}" && pwd)"
export ZZZ_EMBED_REMOTE_SERVER_DIR="$zzz_embed_remote_server_dir"
export RUSTFLAGS="${host_rustflags}"
# Force libz-sys to build its vendored zlib for the bundled host app. Its build
# script tracks this variable, so Cargo rebuilds it when the link mode changes.
LIBZ_SYS_STATIC=1 cargo build "${host_cargo_args[@]}" --target "${target_triple}" --package zzz --package cli
host_artifact_dir="${target_dir}/${target_triple}/${host_build_profile}"

host_binary="${host_artifact_dir}/zzz"
if [[ -n "${bolt_instrument_file}" ]]; then
    mkdir -p "$(dirname "${bolt_instrument_file}")"
    instrumented_binary="${host_binary}.bolt-instrumented"
    llvm-bolt "${host_binary}" \
        -o "${instrumented_binary}" \
        --instrument \
        --instrumentation-file="${bolt_instrument_file}" \
        --instrumentation-file-append-pid \
        --update-debug-sections \
        --use-gnu-stack
    mv "${instrumented_binary}" "${host_binary}"
elif [[ -n "${bolt_perf}" || -n "${bolt_fdata}" ]]; then
    bolt_profile="${bolt_fdata}"
    if [[ -n "${bolt_perf}" ]]; then
        bolt_profile="${host_artifact_dir}/zzz.perf.fdata"
        perf2bolt "${host_binary}" --perfdata="${bolt_perf}" -o "${bolt_profile}"
    fi
    optimized_binary="${host_binary}.bolt"
    llvm-bolt "${host_binary}" \
        -o "${optimized_binary}" \
        --data="${bolt_profile}" \
        --reorder-blocks=ext-tsp \
        --reorder-functions=hfsort+ \
        --split-functions \
        --split-all-cold \
        --icf=safe \
        --plt=hot \
        --dyno-stats \
        --update-debug-sections \
        --use-gnu-stack
    mv "${optimized_binary}" "${host_binary}"
fi

# Upload debug info to sentry.io (explicit opt-in only)
if [[ "${ZZZ_ENABLE_SENTRY_UPLOAD:-}" != "1" ]]; then
    echo "ZZZ_ENABLE_SENTRY_UPLOAD is not set to 1; skipped sentry upload."
elif [[ -z "${SENTRY_AUTH_TOKEN:-}" ]]; then
    echo "SENTRY_AUTH_TOKEN is missing; skipped sentry upload."
elif ! command -v sentry-cli >/dev/null 2>&1; then
    echo "sentry-cli not found. skipping sentry upload."
    echo "install with: 'curl -sL https://sentry.io/get-cli | bash'"
else
    echo "Uploading zzz debug symbols to sentry..."
        # note: this uploads the unstripped binary which is needed because it contains
        # .eh_frame data for stack unwinding. see https://github.com/getsentry/symbolic/issues/783
    for attempt in 1 2 3; do
            echo "Attempting sentry upload (attempt $attempt/3)..."
            if sentry-cli debug-files upload --include-sources --wait -p zed -o zed-dev \
                "${host_artifact_dir}/zzz" \
                "${remote_artifact_dir}/remote_server"; then
                echo "Sentry upload successful on attempt $attempt"
                break
            else
                echo "Sentry upload failed on attempt $attempt"
                if [ $attempt -eq 3 ]; then
                    echo "All sentry upload attempts failed"
                fi
            fi
    done
fi

# Strip debug symbols and save them for upload to DigitalOcean.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
llvm-objcopy --strip-debug "${host_artifact_dir}/zzz"
llvm-objcopy --strip-debug "${host_artifact_dir}/cli"
llvm-objcopy --strip-debug "${remote_artifact_dir}/remote_server"

# Ensure that remote_server does not depend on libssl nor libcrypto, as we got rid of these deps.
if ldd "${remote_artifact_dir}/remote_server" | grep -q 'libcrypto\|libssl'; then
    if [[ "$remote_server_triple" == *-musl ]]; then
        echo "Error: remote_server still depends on libssl or libcrypto" && exit 1
    else
        echo "Info: Using non-musl remote-server build."
    fi
fi

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory.
temp_dir=$(mktemp -d)
zzz_dir="${temp_dir}/zzz$suffix.app"

# Binary
mkdir -p "${zzz_dir}/bin" "${zzz_dir}/libexec"
cp "${host_artifact_dir}/zzz" "${zzz_dir}/libexec/zzz-editor"
cp "${host_artifact_dir}/cli" "${zzz_dir}/bin/zzz"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    LD_LIBRARY_PATH="${FFMPEG_DIR}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
      ldd "${host_artifact_dir}/zzz" |\
        sed -n 's/^[[:space:]]*.*=> \(.*\) (0x[[:xdigit:]]*)$/\1/p' |\
        grep -v '\<\(ld-linux\|libc.so\|libgcc_s.so\|libm.so\|libmvec.so\|libpthread.so\|libdl.so\|librt.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${zzz_dir}/lib"
mapfile -t bundled_libraries < <(find_libs)
if [[ "${#bundled_libraries[@]}" -eq 0 ]]; then
    echo "Error: no runtime libraries were found for ${host_artifact_dir}/zzz" >&2
    exit 1
fi
cp --dereference -- "${bundled_libraries[@]}" "${zzz_dir}/lib"
cp "${FFMPEG_DIR}/LICENSE.txt" "${zzz_dir}/FFmpeg-LICENSE.txt"

# Icons
mkdir -p "${zzz_dir}/share/icons/hicolor/512x512/apps"
cp "crates/zzz/resources/app-icon$suffix.png" "${zzz_dir}/share/icons/hicolor/512x512/apps/zzz.png"
mkdir -p "${zzz_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/zzz/resources/app-icon$suffix@2x.png" "${zzz_dir}/share/icons/hicolor/1024x1024/apps/zzz.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="zzz"
export APP_ICON="zzz"
export APP_ARGS="%U"
if [[ "$channel" == "preview" ]]; then
  export APP_NAME="ZZZ Preview"
  APP_ID="dev.zzz.ZZZ-Preview"
elif [[ "$channel" == "nightly" ]]; then
  export APP_NAME="ZZZ Nightly"
  APP_ID="dev.zzz.ZZZ-Nightly"
elif [[ "$channel" == "dev" ]]; then
  export APP_NAME="ZZZ Dev"
  APP_ID="dev.zzz.ZZZ-Dev"
else
  export APP_NAME="ZZZ"
  APP_ID="dev.zzz.ZZZ"
fi

mkdir -p "${zzz_dir}/share/applications"
envsubst < "crates/zzz/resources/zzz.desktop.in" > "${zzz_dir}/share/applications/$APP_ID.desktop"
chmod +x "${zzz_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${zzz_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="zzz-linux-${arch}.tar.gz"

shopt -s nullglob
old_archives=("${bundle_artifact_dir}"/zzz*-linux-"${arch}".tar.gz)
shopt -u nullglob
if [[ "${#old_archives[@]}" -gt 0 ]]; then
    rm -f -- "${old_archives[@]}"
fi
tar -czvf "${bundle_artifact_dir}/$archive" -C "${temp_dir}" "zzz$suffix.app"

gzip -f --stdout --best "${remote_artifact_dir}/remote_server" > "${target_dir}/zzz-remote-server-linux-${arch}.gz"

if [[ "$package_deb" == true || "$package_rpm" == true ]]; then
    package_assets_dir="${bundle_artifact_dir}/package-assets"
    rm -rf "$package_assets_dir"
    mkdir -p "$package_assets_dir"

    # Cargo-deb and cargo-generate-rpm treat target/release as a logical path
    # and rewrite it for custom profiles and target directories. Keep the
    # metadata stable while staging channel-specific generated assets here.
    cp "${zzz_dir}/share/applications/${APP_ID}.desktop" "$package_assets_dir/zzz.desktop"
    cp "${zzz_dir}/share/icons/hicolor/512x512/apps/zzz.png" "$package_assets_dir/zzz.png"
    cp "${zzz_dir}/share/icons/hicolor/1024x1024@2x/apps/zzz.png" "$package_assets_dir/zzz@2x.png"
    cp "assets/licenses.md" "$package_assets_dir/licenses.md"
    cp "${zzz_dir}/FFmpeg-LICENSE.txt" "$package_assets_dir/FFmpeg-LICENSE.txt"

    if [[ "$package_deb" == true ]]; then
        cargo deb --locked --no-build --package zzz --profile "$host_build_profile" \
            --variant "$package_variant" \
            --output "${bundle_artifact_dir}/zzz-${package_variant}-linux-${arch}.deb"
    fi

    if [[ "$package_rpm" == true ]]; then
        cargo generate-rpm --package crates/zzz --profile "$host_build_profile" \
            --variant "$package_variant" \
            --output "${bundle_artifact_dir}/zzz-${package_variant}-linux-${arch}.rpm"
    fi
fi
