#!/usr/bin/env bash

set -euo pipefail

"$(dirname "$0")/check-philosophy"

has_package_selection=false
if [[ " $* " == *" -p "* || " $* " == *" --package "* ]]; then
    has_package_selection=true
fi

if [[ "$has_package_selection" == false ]]; then
    set -- "$@" --workspace
fi

if command -v ccache >/dev/null 2>&1 && [[ -z "${CCACHE_DIR:-}" ]]; then
    ccache_dir="$(ccache --get-config cache_dir)"
    ccache_parent_dir="$(dirname "$ccache_dir")"

    if [[ ! -d "$ccache_dir" && ! -w "$ccache_parent_dir" ]] || [[ -d "$ccache_dir" && ! -w "$ccache_dir" ]]; then
        export CCACHE_DIR="$(pwd)/target/ccache"
        mkdir -p "$CCACHE_DIR"
    fi
fi

set -x
"${CARGO:-cargo}" clippy "$@" --release --all-targets --all-features -- \
    --deny warnings \
    --deny clippy::manual_range_contains \
    --deny clippy::match_result_ok

# Run a second pass for low-noise strict manifest checks across the requested packages.
"${CARGO:-cargo}" clippy "$@" --release --all-features -- \
    --deny warnings \
    --warn clippy::negative_feature_names \
    --warn clippy::wildcard_dependencies

# `future_not_send` is high-signal for background or thread-safe utility crates, but
# much noisier in GPUI crates that intentionally await on main-thread local state.
if [[ "$has_package_selection" == true ]]; then
    "${CARGO:-cargo}" clippy "$@" --release --all-features -- \
        --deny warnings \
        --warn clippy::future_not_send
else
    "${CARGO:-cargo}" clippy \
        --release \
        --all-features \
        -p cli \
        -p compliance \
        -p git \
        -p language_model \
        -p lsp \
        -p sqlez \
        -p theme \
        -p watch \
        -p xtask \
        -- \
        --deny warnings \
        --warn clippy::future_not_send
fi

# Run style-focused checks as a separate pass so failures stay grouped and readable.
"${CARGO:-cargo}" clippy "$@" --release --all-features -- \
    --deny warnings \
    --warn clippy::redundant_else \
    --warn clippy::needless_continue

# If local, run other checks if we have the tools installed.
if [[ -z "${GITHUB_ACTIONS+x}" ]]; then
    which cargo-machete >/dev/null 2>&1 || exit 0
    cargo machete

    which typos >/dev/null 2>&1 || exit 0
    typos --config typos.toml

    which buf >/dev/null 2>&1 || exit 0
    buf lint crates/proto/proto
    buf format --diff --exit-code crates/proto/proto
fi
