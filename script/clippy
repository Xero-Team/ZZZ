#!/usr/bin/env bash

set -euo pipefail

# The base lint gate lives in `[workspace.lints]` (Cargo.toml), so the
# low-noise strict lints (safety docs, unsafe-op grouping, error handling,
# pointer provenance) apply to every `cargo clippy` invocation below. The
# passes in this script cover what workspace lint levels cannot: denying the
# `warnings` group, opt-in lints that are too noisy to gate workspace-wide, and
# the non-clippy checks. See the comment above the block in Cargo.toml for how
# to evaluate a new low-noise candidate.
"$(dirname "$0")/check-philosophy"

has_package_selection=false
if [[ " $* " == *" -p "* || " $* " == *" --package "* ]]; then
    has_package_selection=true
fi

if [[ "$has_package_selection" == false ]]; then
    set -- "$@" --workspace
fi

if command -v ccache >/dev/null 2>&1 && [[ -z "${CCACHE_DIR:-}" ]]; then
    ccache_dir="$(ccache --get-config cache_dir)"
    ccache_parent_dir="$(dirname "$ccache_dir")"

    if [[ ! -d "$ccache_dir" && ! -w "$ccache_parent_dir" ]] || [[ -d "$ccache_dir" && ! -w "$ccache_dir" ]]; then
        export CCACHE_DIR="$(pwd)/target/ccache"
        mkdir -p "$CCACHE_DIR"
    fi
fi

# The workspace lint table is the single source of truth for the deny set, and
# this pass runs with `--all-targets` so tests, benches, and examples are held
# to the same bar as library and binary targets. The only CLI lints below are
# the deny-the-warnings group and opt-in lints that are deliberately not
# workspace-wide.
set -x
"${CARGO:-cargo}" clippy "$@" --release --all-targets --all-features -- \
    --deny warnings

# Run a second pass for low-noise strict manifest checks. These stay on the
# command line rather than in `[workspace.lints]` because they are manifest
# lints that path-dependency crates without `[lints] workspace = true` would
# otherwise miss. Manifest lints are target-independent, so this pass does not
# need `--all-targets`.
"${CARGO:-cargo}" clippy "$@" --release --all-features -- \
    --deny warnings \
    --deny clippy::negative_feature_names \
    --deny clippy::wildcard_dependencies

# `future_not_send` is high-signal for background or thread-safe utility crates,
# but much noisier in GPUI crates that intentionally await on main-thread local
# state, and in test futures. Restrict it to library/binary targets: enforce it
# for the curated utility packages, and allow it for an explicit `-p` selection
# so a targeted run on a GPUI crate is not blocked. `--allow` is required rather
# than `--warn`: `--deny warnings` promotes any warning to an error, so `--warn`
# here would still fail the run.
if [[ "$has_package_selection" == true ]]; then
    "${CARGO:-cargo}" clippy "$@" --release --all-features -- \
        --deny warnings \
        --allow clippy::future_not_send
else
    "${CARGO:-cargo}" clippy \
        --release \
        --all-features \
        -p cli \
        -p compliance \
        -p git \
        -p language_model \
        -p lsp \
        -p sqlez \
        -p theme \
        -p watch \
        -p xtask \
        -- \
        --deny warnings \
        --deny clippy::future_not_send
fi

# When run locally, also run the auxiliary checks for whichever tools are
# installed. Each tool is guarded independently so a missing one skips only
# its own check instead of silently marking the whole run successful.
if [[ -z "${GITHUB_ACTIONS+x}" ]]; then
    if command -v cargo-machete >/dev/null 2>&1; then
        cargo machete
    fi

    if command -v typos >/dev/null 2>&1; then
        typos --config typos.toml
    fi

    if command -v buf >/dev/null 2>&1; then
        buf lint crates/proto/proto
        buf format --diff --exit-code crates/proto/proto
    fi
fi
