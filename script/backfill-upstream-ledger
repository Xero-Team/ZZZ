#!/usr/bin/env python3
"""Backfill both upstream decision ledgers from the sync reports.

The reports carry every decision in prose tables. Two ledgers make those
decisions machine-readable from one pass, so they cannot disagree:

- `upstream-ledger.tsv` records the A and B commits, with the verification
  status the local history can prove for the most recent batches.
- `upstream-rejected.tsv` records the C commits that were skipped.

Both files are generated, never hand-edited.
"""

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DIR = ROOT / "docs" / "src" / "development"
REPORTS = DIR / "upstream"
LEDGER = DIR / "upstream-rejected.tsv"
ABSORBED = DIR / "upstream-ledger.tsv"

# How many batches keep a verification status. Past this many reports the
# backfill will not re-litigate history: the rows are `unknown`, which the gate
# accepts, rather than a claim nobody can check today.
RECENT_REPORTS = 3

SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")
ABSORBED_RE = re.compile(r"(?:Upstream: |cherry picked from commit )([0-9a-f]{7,40})")
CLASSES = ("A", "B", "C")
VERIFY_STATUSES = ("verified", "equivalent", "unverified", "unknown")

# A disposition that says the local tree already matched upstream describes a
# batch with no commit to find, which is a different fact from a missing
# trailer. The phrasing is the reports' own convention for that case.
EQUIVALENT_RE = re.compile(
    r"\balready equivalent\b|\balready matches\b|\bno (?:code|local) change\b",
    re.IGNORECASE,
)
REASONS = (
    "philosophy",
    "absent-api",
    "unisolatable",
    "upstream-infra",
    "release-metadata",
    "diverged",
    "untriaged",
)

PATTERNS = (
    ("philosophy", r"telemetry|account|billing|subscription|trial|upgrade|copilot|chatgpt|collab|native agent|zed agent|hosted|cloud|discord|onboarding|mercury|zeta|sign"),
    ("release-metadata", r"release metadata|version follow|bump zed|bump zzz"),
    ("upstream-infra", r"release|lockfile|npm|benchmark|workflow|marketing|triage|infra|bloat|flaky|upstream-only|metadata|docs"),
    ("absent-api", r"absent|does not exist|not present|no local|missing|deleted|no zzz caller|not compile|no caller|has no"),
    ("diverged", r"diverg|conflict"),
    ("unisolatable", r"unisolat|rewrite|refactor|entangl|multiworkspace|cannot be isolated"),
)

# Tie-break order for equally specific matches. Product-behavior classes come
# before the catch-all infrastructure bin so that a disposition which happens to
# mention a benchmark or a workflow is not filed as infrastructure.
PRIORITY = (
    "philosophy",
    "release-metadata",
    "absent-api",
    "diverged",
    "upstream-infra",
    "unisolatable",
)

# A disposition that names a crate path or an inline code span is describing a
# local surface, so falling through to `untriaged` would hide the reason.
NAMES_LOCAL_SURFACE = re.compile(r"crates/[a-z_0-9]+/|`[a-z_0-9]+`")


def reason_for(note):
    low = note.lower()
    matched = [
        code for code, pattern in PATTERNS if re.search(pattern, low)
    ]
    if matched:
        for code in PRIORITY:
            if code in matched:
                return code
    if NAMES_LOCAL_SURFACE.search(low):
        return "absent-api"
    return "untriaged"


def clean(text):
    text = text.replace("\t", " ")
    text = text.replace("\n", " ")
    text = text.replace("\r", " ")
    return re.sub(r"\s+", " ", text).strip()


def table_rows(path):
    found = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line.startswith("|"):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) != 4:
            continue
        sha = cells[0]
        cls = cells[1]
        if cls in CLASSES and SHA_RE.match(sha):
            found.append((sha, cls, clean(cells[3])))
    return found


def block_rows(path):
    note = "Rejected in this sync; see the report for the section-level rationale."
    found = []
    inside = False
    fence = False
    for line in path.read_text(encoding="utf-8").splitlines():
        if re.match(r"^#{2,3} ", line):
            inside = bool(re.match(r"^#{2,3} C[:\s]", line))
            fence = False
            continue
        if not inside:
            continue
        if line.strip().startswith("```"):
            fence = not fence
            continue
        if fence:
            for token in line.split():
                if SHA_RE.match(token):
                    found.append((token, "C", note))
    return found


def collect(reports):
    latest = {}
    longest = {}
    for path in reports:
        rows = table_rows(path) + block_rows(path)
        for sha, cls, note in rows:
            prefix = sha[:8]
            old = longest.get(prefix, "")
            if len(sha) > len(old):
                longest[prefix] = sha
            latest[prefix] = (cls, note, path.name)
    result = {}
    for prefix in latest:
        cls, note, source = latest[prefix]
        result[prefix] = (longest[prefix], cls, note, source)
    return result


def render(decisions):
    header = []
    header.append("# ZZZ upstream rejection ledger (class C).")
    header.append("#")
    header.append("# One row per upstream commit ZZZ classified C and did not absorb.")
    header.append("# This is the dedup index for re-review: a SHA listed here was")
    header.append("# already rejected and must not be re-triaged unless a later")
    header.append("# report supersedes it.")
    header.append("#")
    header.append("# Columns (tab-separated): sha, class, reason_code, note, source")
    header.append("# reason_code is one of: " + ", ".join(REASONS) + ".")
    header.append("# untriaged marks a backfilled row whose bucket still needs review.")
    header.append("# Regenerate: ./script/backfill-upstream-ledger")
    header.append("# Validate:   ./script/check-upstream-ledger")
    header.append("sha\tclass\treason_code\tnote\tsource")
    body = []
    for prefix in sorted(decisions):
        sha, cls, note, source = decisions[prefix]
        if cls != "C":
            continue
        fields = [sha, "C", reason_for(note), note, source]
        body.append("\t".join(fields))
    return "\n".join(header + body) + "\n"


def absorbed_prefixes():
    """The upstream SHAs local history says it absorbed.

    A commit that carries an `Upstream: <sha>` or `cherry picked from commit
    <sha>` trailer is the only local evidence that an upstream change is
    present, so that is what `verified` means.
    """
    log = subprocess.run(
        ["git", "-C", str(ROOT), "log", "--format=%B"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    return {match.group(1)[:8] for match in ABSORBED_RE.finditer(log)}


def recent_reports(reports):
    """The newest reports that recorded an absorbed commit.

    Reports with no A or B row cannot carry a verification status, so they are
    skipped when counting: the window is the last RECENT_REPORTS batches that
    actually absorbed something.
    """
    contributing = [
        path.name
        for path in reports
        if any(cls != "C" for _, cls, _ in table_rows(path) + block_rows(path))
    ]
    return set(contributing[-RECENT_REPORTS:])


def verify_for(prefix, note, report, absorbed, recent):
    if report not in recent:
        return "unknown"
    if EQUIVALENT_RE.search(note):
        return "equivalent"
    return "verified" if prefix in absorbed else "unverified"


def render_absorbed(decisions, absorbed, recent):
    header = []
    header.append("# ZZZ upstream absorbed ledger (classes A and B).")
    header.append("#")
    header.append("# One row per upstream commit ZZZ classified A or B: the decision")
    header.append("# to absorb it, and whether local history can prove it happened.")
    header.append("# The skipped half of each batch is in upstream-rejected.tsv; a SHA")
    header.append("# appears in exactly one of the two files.")
    header.append("#")
    header.append("# Columns (tab-separated): sha, class, verify, report")
    header.append("# verify is one of: " + ", ".join(VERIFY_STATUSES) + ".")
    header.append(
        "# verified   - an absorbed-commit trailer in local history names this SHA"
    )
    header.append(
        "# equivalent - the batch found the local tree already matched upstream,"
    )
    header.append("#              so no local commit carries a trailer")
    header.append(
        "# unverified - the batch recorded the decision, but nothing proves it"
    )
    header.append(
        "# unknown    - the row predates the newest "
        + str(RECENT_REPORTS)
        + " absorbing batches"
    )
    header.append("# Regenerate: ./script/backfill-upstream-ledger")
    header.append("# Validate:   ./script/check-upstream-ledger")
    header.append("sha\tclass\tverify\treport")
    body = []
    for prefix in sorted(decisions):
        sha, cls, note, report = decisions[prefix]
        if cls == "C":
            continue
        fields = [sha, cls, verify_for(prefix, note, report, absorbed, recent), report]
        body.append("\t".join(fields))
    return "\n".join(header + body) + "\n"


def shown(path):
    try:
        return path.relative_to(ROOT)
    except ValueError:
        return path


def main():
    directory = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else DIR
    reports = []
    for path in sorted(REPORTS.glob("upstream-sync-*.md")):
        if path.name.startswith("upstream-sync-audit-"):
            continue
        reports.append(path)
    if not reports:
        print("no sync reports found", file=sys.stderr)
        return 1
    decisions = collect(reports)
    recent = recent_reports(reports)
    absorbed = absorbed_prefixes()
    (directory / LEDGER.name).write_text(render(decisions), encoding="utf-8")
    (directory / ABSORBED.name).write_text(
        render_absorbed(decisions, absorbed, recent), encoding="utf-8"
    )
    rejected = sum(1 for prefix in decisions if decisions[prefix][1] == "C")
    taken = len(decisions) - rejected
    verified = sum(
        1
        for prefix, (_, cls, note, report) in decisions.items()
        if cls != "C"
        and verify_for(prefix, note, report, absorbed, recent) == "verified"
    )
    print(
        "wrote "
        + str(rejected)
        + " rejection rows to "
        + str(shown(directory / LEDGER.name))
        + " and "
        + str(taken)
        + " absorbed rows ("
        + str(verified)
        + " verified) to "
        + str(shown(directory / ABSORBED.name))
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
