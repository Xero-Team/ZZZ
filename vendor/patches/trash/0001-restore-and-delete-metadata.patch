+    let mut cleanup_paths = CleanupPaths::new();
+    let path = std::env::current_dir()
+        .expect("Should be able to get current directory")
+        .join(get_unique_name());
+    cleanup_paths.push(path.clone());
+    File::create_new(&path).unwrap();
+
