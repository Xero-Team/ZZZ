     };
 
+    // Neither MSVC's assembler nor `clang-cl`'s usual mode can build the GAS
+    // sources when the host is not Windows, so they are preprocessed and
+    // assembled as `.S` files instead. That requires the same target defines
+    // the non-MSVC path passes, which the sources use to pick their syntax.
+    let staged_asm = if msvc && !masm && asm.ends_with(".s") {
+        Some(stage_gnu_assembly(asm))
+    } else {
+        None
+    };
+
+    if staged_asm.is_some() {
+        // `#include "psm.h"` is looked up next to the staged copy first. The
+        // path is absolute because the compile below runs from `OUT_DIR`.
+        cfg.include(
+            std::path::Path::new(
+                &std::env::var("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR not set"),
+            )
+            .join("src/arch"),
+        );
+    }
     if !msvc {
         cfg.flag("-xassembler-with-cpp");
+    }
+    if !msvc || staged_asm.is_some() {
         cfg.define(&*format!("CFG_TARGET_OS_{}", os), None);
         cfg.define(&*format!("CFG_TARGET_ARCH_{}", arch), None);
         cfg.define(&*format!("CFG_TARGET_ENV_{}", env), None);
@@ -184,7 +226,18 @@
