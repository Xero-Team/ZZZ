+/// Stages a GAS source in `OUT_DIR` under its `.S` spelling.
+///
+/// The `.S` extension is the only portable way to ask a driver for the C
+/// preprocessor: `clang-cl` has no `-x` option and refuses to preprocess a
+/// `.s` file, while the sources this crate ships select their syntax with
+/// `#ifdef` and expand `#include`. A copy is staged because the crate source
+/// directory has to stay untouched.
+fn stage_gnu_assembly(asm: &str) -> String {
+    use std::path::Path;
+
+    let source = Path::new(asm);
+    let out_dir = std::env::var("OUT_DIR").expect("OUT_DIR environment variable not set");
+    let name = source
+        .file_name()
+        .expect("assembly source file name missing");
+    let staged = Path::new(&out_dir).join(name).with_extension("S");
+    std::fs::copy(source, &staged).expect("Failed to stage assembly source");
+    staged.to_string_lossy().into_owned()
+}
+
 fn main() {
     use std::env::var;
 
@@ -98,8 +118,30 @@
